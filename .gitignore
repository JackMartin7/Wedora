# Built application files
/build/
/app/build/
/*/build/
/app/release/

# Gradle
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Local configuration (SDK path, signing, etc.)
local.properties

# Release signing — keystore.properties holds the store/key passwords in
# plain text; the keystore file itself is the actual private key. Neither
# should ever reach version control. See app/build.gradle.kts's
# signingConfigs block for how these are read at build time.
keystore.properties
*.jks
*.keystore

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Firebase — contains project ID + API key; each environment supplies its own
/app/google-services.json

# Firebase Admin SDK service account keys — a private key with whatever IAM
# roles the service account has (Firestore read/write, etc.), not just a
# per-environment config value like google-services.json above. Matched by
# name pattern, not one specific filename, so a newly generated key is
# covered automatically without a .gitignore update every time one is made.
*firebase-adminsdk*.json
serviceAccount*.json

# Firebase CLI local cache (debug logs are already covered by *.log above)
.firebase/
