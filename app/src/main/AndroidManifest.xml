<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coarse is deliberate: city-level accuracy is all Complete Profile needs,
         and it is less invasive than ACCESS_FINE_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required on API 33+ to post local notifications (matches/messages/likes).
         No-op below API 33, where notifications don't need runtime consent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WedoraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Wedora"
        android:theme="@style/Theme.Wedora"
        android:supportsRtl="true">

        <!-- Real AdMob App ID — see NativeAdLoader.kt for the three
             placements' own ad unit IDs. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6998303779941960~4404028839" />

        <!--
            Ads and Analytics each ship their own AD_SERVICES_CONFIG pointing at
            a different resource, which the manifest merger cannot reconcile on
            its own. tools:replace picks ours — see the file's own comment for
            why it's a local union rather than either SDK's internal resource.
        -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ad_services_config"
            tools:replace="android:resource" />

        <!-- Push notifications — see WedoraFirebaseMessagingService's own
             doc comment for why send_notification.php sends data-only
             payloads rather than "notification" ones. -->
        <service
            android:name=".WedoraFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Wedora.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- adjustResize is largely inert here now: WedoraBaseActivity calls
             enableEdgeToEdge() on every screen, which calls
             WindowCompat.setDecorFitsSystemWindows(window, false) — and per
             Android's edge-to-edge guidance, that stops the window from
             automatically resizing for the IME at all, regardless of this
             attribute. Kept set anyway since it's harmless and this is still
             the conventional signal for "this screen has text input"; the
             actual fix is WedoraBaseActivity.applyEdgeInsets's applyIme
             parameter (see LoginActivity.onCreate), which pads the ScrollView
             root by the keyboard's own inset so a low-enough field like
             etPassword is pushed above it instead of ending up in the IME's
             (invisible but still touch-intercepting) covered area. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GuestGenderPromptActivity"
            android:exported="false" />

        <!-- adjustResize — see LoginActivity's own comment; identical layout
             shape (ScrollView, etPassword/applyIme=true), identical fix. -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- adjustResize — see LoginActivity's own comment. Only one field
             here (etEmail), but it sits low enough on screen (below the
             illustration) to reach the same IME-covers-the-field issue. -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Progressive profile setup. adjustResize so the keyboard doesn't
             cover the Continue button on the text-entry steps. -->
        <activity
            android:name=".ProfileStep1NameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileStep2GenderActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStep3StatusActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStepPermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStep4DetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileStep5PhotoActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileDetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AccountSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PrivacySafetyActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".HelpCenterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TermsOfServiceActivity"
            android:exported="false" />

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".PaymentSubscriptionActivity"
            android:exported="false" />

        <!--
            The blocking forced-update gate. noHistory so it can never be
            returned to via recents once the requirement is satisfied, and
            excludeFromRecents so a user cannot resume straight back into a
            dead-end screen after swiping the app away.
        -->
        <activity
            android:name=".UpdateRequiredActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <activity
            android:name=".FilterActivity"
            android:exported="false" />

        <activity
            android:name=".ExploreActivity"
            android:exported="false" />

        <activity
            android:name=".NearbyListActivity"
            android:exported="false" />

        <activity
            android:name=".MatchHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileViewersActivity"
            android:exported="false" />

        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".LikesActivity"
            android:exported="false" />

        <!-- singleTop: goToChats() below reuses this instance via CLEAR_TOP +
             SINGLE_TOP rather than recreating it, so the already-rendered list
             stays on screen through the return transition instead of a blank
             window rebuilding from scratch. -->
        <activity
            android:name=".ChatsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ChatThreadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileActivity"
            android:exported="true">
            <!--
                wedora://settings/version — the update spec's deep link, and the
                target for the profile-avatar update badge and any push nudge.
                Lands on Profile, where the App Version row lives.

                exported="true" is required for a browsable filter to work at
                all; the Activity itself shows only the signed-in user's own
                profile and takes no data from the intent, so an external
                caller gains nothing beyond opening the screen.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="wedora"
                    android:host="settings"
                    android:path="/version" />
            </intent-filter>
        </activity>

        <!-- Hidden admin-only screens — see WedoraAdmin.UID and
             ProfileActivity's own hidden settings row. Not exported: only
             ever reached from inside this app's own task, by a UID both
             screens re-check on their own onCreate regardless. -->
        <activity
            android:name=".AdminReportsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminReportDetailActivity"
            android:exported="false" />

        <activity
            android:name=".AdminPhotoMigrationActivity"
            android:exported="false" />

    </application>

</manifest>
