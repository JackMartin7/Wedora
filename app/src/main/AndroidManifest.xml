<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coarse is deliberate: city-level accuracy is all Complete Profile needs,
         and it is less invasive than ACCESS_FINE_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required on API 33+ to post local notifications (matches/messages/likes).
         No-op below API 33, where notifications don't need runtime consent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WedoraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Wedora"
        android:theme="@style/Theme.Wedora"
        android:supportsRtl="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Wedora.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <!-- Progressive profile setup. adjustResize so the keyboard doesn't
             cover the Continue button on the text-entry steps. -->
        <activity
            android:name=".ProfileStep1NameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileStep2GenderActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStep3StatusActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStepPermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileStep4DetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileStep5PhotoActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileDetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AccountSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PrivacySafetyActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".HelpCenterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TermsOfServiceActivity"
            android:exported="false" />

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".PaymentSubscriptionActivity"
            android:exported="false" />

        <activity
            android:name=".FilterActivity"
            android:exported="false" />

        <activity
            android:name=".ExploreActivity"
            android:exported="false" />

        <activity
            android:name=".NearbyListActivity"
            android:exported="false" />

        <activity
            android:name=".MatchHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".LikesActivity"
            android:exported="false" />

        <!-- singleTop: goToChats() below reuses this instance via CLEAR_TOP +
             SINGLE_TOP rather than recreating it, so the already-rendered list
             stays on screen through the return transition instead of a blank
             window rebuilding from scratch. -->
        <activity
            android:name=".ChatsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ChatThreadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

    </application>

</manifest>
