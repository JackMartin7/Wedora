<?xml version="1.0" encoding="utf-8"?>
<!--
    Interest-picker chip fill. Same reasoning as chip_bg_tint: one surface for
    both states, selection carried by border and label.

    Unselected was wedora_tag_bg, an accent-tinted pink, which made a grid of
    unselected interests read as half-chosen. Now a neutral surface.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/wedora_chip_surface" android:state_checked="true" />
    <item android:color="@color/wedora_chip_surface" />
</selector>
