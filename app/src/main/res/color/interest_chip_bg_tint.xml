<?xml version="1.0" encoding="utf-8"?>
<!-- Interest chip fill: solid accent when selected, light accent-tinted wash
     when not — distinct from chip_bg_tint.xml (WedoraChip's neutral-surface
     unselected state), per the interest-picker's own reference design. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/wedora_accent" android:state_checked="true" />
    <item android:color="@color/wedora_tag_bg" />
</selector>
