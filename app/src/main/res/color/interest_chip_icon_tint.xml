<?xml version="1.0" encoding="utf-8"?>
<!-- Interest chip icon: white on the accent fill (matching the label), a
     subtle secondary tint on the unselected light wash rather than the full
     dark text color, so the icon reads as decoration rather than competing
     with the label. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/white" android:state_checked="true" />
    <item android:color="@color/wedora_text_secondary" />
</selector>
