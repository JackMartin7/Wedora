<?xml version="1.0" encoding="utf-8"?>
<!--
    Interest-picker chip icon. Accent when selected, matching the label;
    recessive otherwise, so the icon reinforces the state rather than
    competing with it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/wedora_accent" android:state_checked="true" />
    <item android:color="@color/wedora_text_secondary" />
</selector>
