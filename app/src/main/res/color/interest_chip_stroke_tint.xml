<?xml version="1.0" encoding="utf-8"?>
<!--
    Interest-picker chip border. New: this style had no stroke at all, because
    its selected state used to be a solid accent fill that needed none.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/wedora_accent" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
