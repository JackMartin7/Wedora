<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch thumb — LIGHT mode. Dark-mode counterpart in color-night/, which
    MUST keep the same filename and states so the system can swap it.

    Off is a real neutral grey rather than a faded accent, so "off" reads as
    off at a glance instead of as a dimmer "on".
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#FA4659" android:state_checked="true" />
    <item android:color="#B8ABAE" />
</selector>
