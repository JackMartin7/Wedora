<?xml version="1.0" encoding="utf-8"?>
<!-- "This message was deleted" fill for a received bubble. Structurally a
     duplicate of bg_bubble_received (same tail-corner shape, same border),
     but deliberately NOT a reference to it: bg_bubble_received's fill is
     wedora_surface, which goes dark in night mode, while a deleted bubble
     must stay the fixed white given for this feature regardless of theme —
     see wedora_message_deleted_bubble's own comment. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wedora_message_deleted_bubble" />
    <stroke
        android:width="1dp"
        android:color="@color/wedora_border" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="16dp" />
</shape>
