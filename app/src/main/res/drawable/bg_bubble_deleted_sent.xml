<?xml version="1.0" encoding="utf-8"?>
<!-- "This message was deleted" fill for a sent bubble — overrides
     bg_bubble_sent's accent fill with the fixed white WhatsApp uses for a
     deleted message, regardless of who sent it. Same tail-corner shape as
     bg_bubble_sent so swapping backgrounds doesn't change the bubble's
     silhouette, just its color. A border is added (bg_bubble_sent has none,
     since accent-on-background already reads clearly) since plain white
     wouldn't otherwise stand out against wedora_bg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wedora_message_deleted_bubble" />
    <stroke
        android:width="1dp"
        android:color="@color/wedora_border" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="4dp" />
</shape>
