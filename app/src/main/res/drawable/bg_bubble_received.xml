<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming message bubble: surface fill with a hairline border, mirroring
     bg_bubble_sent's tightened corner on the opposite side. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wedora_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/wedora_border" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="16dp" />
</shape>
