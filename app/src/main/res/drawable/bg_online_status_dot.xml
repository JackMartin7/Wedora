<?xml version="1.0" encoding="utf-8"?>
<!--
    Green online-status dot with a white ring, overlaid at the bottom-end
    corner of an avatar. The stroke is a fixed 2dp regardless of the view's
    size, so it reads correctly at both the standard 12dp and ProfileDetail's
    larger 16dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/wedora_status_dot" />
    <stroke
        android:width="2dp"
        android:color="@color/white" />
</shape>
