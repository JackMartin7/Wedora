<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom-anchored darkening scrim so white name text stays legible over any
    photo. Fixed black-alpha ramp rather than a theme colour: it darkens the
    image the same way in light and dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#B3000000"
        android:centerColor="#4D000000"
        android:endColor="#00000000" />
</shape>
