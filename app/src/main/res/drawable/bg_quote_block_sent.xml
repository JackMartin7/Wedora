<?xml version="1.0" encoding="utf-8"?>
<!-- Quoted-reply strip inside a sent (accent-fill) bubble — a subtle
     translucent-white wash so it reads as "inside this bubble" rather than
     a separate box, matching WhatsApp's own quoted-preview treatment. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <corners android:radius="8dp" />
</shape>
