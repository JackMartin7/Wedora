<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-bleed photo placeholder for the swipe-stack skeleton, at the swipe
    card's own 40dp radius.

    Separate from bg_skeleton_card rather than a bump to it: that one is 16dp
    and is still correct for the skeletons this change does not touch.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wedora_skeleton" />
    <corners android:radius="40dp" />
</shape>
