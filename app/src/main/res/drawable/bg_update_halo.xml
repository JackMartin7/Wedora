<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent rounded square drifting behind the shield on the blocking
     screen — keeps that screen from reading as a frozen crash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2EFFFFFF" />
    <corners android:radius="34dp" />
</shape>
