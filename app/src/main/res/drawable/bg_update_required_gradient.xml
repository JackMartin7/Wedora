<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed coral for the blocking update screen. Fixed in both light and
     dark: a forced update must read as an unmistakable stop, and letting it
     go pale in dark mode would undercut that. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="290"
        android:startColor="#FF93A8"
        android:centerColor="#FE4667"
        android:endColor="#E23048" />
</shape>
