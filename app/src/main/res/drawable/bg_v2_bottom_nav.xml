<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom nav surface for the redesigned screens (Home, Explore).

    A v2 copy rather than an edit of bg_bottom_nav.xml on purpose: that
    drawable is shared by all five tab screens, so changing it would restyle
    Likes, Chats and Profile too — which this phased rollout is explicitly
    avoiding. Those three keep pointing at the original.

    The design specifies rgba(18,13,18,0.8) with a backdrop blur. Rendered
    opaque here: the nav sits above scrolling content, and a translucent bar
    with no blur behind it reads as a smear of whatever scrolls under it
    rather than as glass. Opaque loses the effect but not the legibility.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wedora_v2_hairline" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/wedora_v2_bg" />
        </shape>
    </item>
</layer-list>
