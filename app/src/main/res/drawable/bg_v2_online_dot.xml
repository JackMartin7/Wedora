<?xml version="1.0" encoding="utf-8"?>
<!-- Online indicator. The 2dp page-coloured stroke is what separates the dot
     from a photo it overlaps, which is why it is not simply a green oval. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/wedora_status_dot" />
    <stroke android:width="2dp" android:color="@color/wedora_bg" />
</shape>
