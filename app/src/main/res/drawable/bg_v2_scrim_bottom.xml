<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom scrim for a card photo, behind the action row, bio and pills.

    The design ramps from transparent at 60% to 80% black. A shape gradient's
    centre stop is fixed at 50%, so this holds transparent through the centre
    and ramps to black below it — slightly earlier than the design's 60%, and
    erring toward more contrast rather than less.

    angle=270 runs top-to-bottom, so startColor is the BOTTOM of the view.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#CC000000"
        android:centerColor="@android:color/transparent"
        android:endColor="@android:color/transparent" />
</shape>
