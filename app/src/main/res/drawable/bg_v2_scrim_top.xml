<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the top of a card photo so the overlaid name and buttons stay
     legible over a bright image. This is the only thing between white text
     and an arbitrary photo, so it is not decorative. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#99000000"
        android:endColor="@android:color/transparent" />
    <!--
        Top corners only. This view is 88dp pinned to the top of the card, so
        its top edge follows the card's rounding while its bottom edge sits
        mid-photo and has to stay square.

        Without this the scrim drew as a hard rectangle over a photo clipped
        to 40dp, leaving square dark corners proud of the rounded image.

        40dp must stay in step with bg_v2_card and WedoraCardImageV2.
    -->
    <corners
        android:topLeftRadius="40dp"
        android:topRightRadius="40dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
