<!--
    Forgot Password illustration: an envelope with a padlock — "we'll email you
    a way back into your account."

    Same theme rules as ic_login_illustration: only the accent (#FA4659) and a
    soft pink (#FFDADE), transparent background, nothing white or near-black, so
    it holds up on both the light and the dark screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="280dp"
    android:height="220dp"
    android:viewportWidth="280"
    android:viewportHeight="220">

    <!-- Soft ring behind the envelope (soft pink, 40%). -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFDADE"
        android:strokeAlpha="0.4"
        android:strokeWidth="6"
        android:pathData="M62,110 A78,78 0 1 1 218,110 A78,78 0 1 1 62,110 Z" />

    <!-- Envelope body: soft-pink fill with an accent outline. -->
    <path
        android:fillColor="#FFDADE"
        android:strokeColor="#FA4659"
        android:strokeWidth="5"
        android:pathData="M80,82 h120 a10,10 0 0 1 10,10 v62 a10,10 0 0 1 -10,10 h-120 a10,10 0 0 1 -10,-10 v-62 a10,10 0 0 1 10,-10 Z" />

    <!-- Envelope flap crease. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FA4659"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M74,86 L140,132 L206,86" />

    <!-- Padlock shackle. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FA4659"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M133,122 v-6 a7,7 0 0 1 14,0 v6" />

    <!-- Padlock body (accent). -->
    <path
        android:fillColor="#FA4659"
        android:pathData="M132,122 h16 a4,4 0 0 1 4,4 v14 a4,4 0 0 1 -4,4 h-16 a4,4 0 0 1 -4,-4 v-14 a4,4 0 0 1 4,-4 Z" />

    <!-- Keyhole (soft pink, punched out of the lock body). -->
    <path
        android:fillColor="#FFDADE"
        android:pathData="M140,131 m-2.5,0 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0 Z" />
    <path
        android:fillColor="#FFDADE"
        android:pathData="M138.5,132 h3 l-1,7 h-1 Z" />

    <!-- Scattered decorative dots (soft pink). -->
    <path android:fillColor="#FFDADE" android:pathData="M48,66 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 Z" />
    <path android:fillColor="#FFDADE" android:pathData="M232,60 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 Z" />
    <path android:fillColor="#FFDADE" android:pathData="M56,178 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0 Z" />
    <path android:fillColor="#FFDADE" android:pathData="M224,176 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 Z" />
    <path android:fillColor="#FFDADE" android:pathData="M140,26 m-3,0 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z" />

    <!-- A 4-point sparkle (soft pink). -->
    <path
        android:fillColor="#FFDADE"
        android:pathData="M210,100 L212,106 L218,108 L212,110 L210,116 L208,110 L202,108 L208,106 Z" />
</vector>
