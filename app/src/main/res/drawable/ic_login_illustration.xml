        android:fillColor="#00000000"
        android:strokeColor="#FFDADE"
        android:strokeAlpha="0.4"
        android:strokeWidth="6"
        android:pathData="M55,118 A85,85 0 1 1 225,118 A85,85 0 1 1 55,118 Z" />

