<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/admin_report_detail_title"
        android:textColor="@color/wedora_text"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/wedora_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- ===== Content ===== -->

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/actionRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- Reported user -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_report_reported_user_heading"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:letterSpacing="0.05" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivReportedPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_avatar_placeholder"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_profile_photo"
                app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

            <TextView
                android:id="@+id/tvReportedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/wedora_text"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                tools:text="Amelia Hart" />

            <TextView
                android:id="@+id/tvReportedAgeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="24 • Islamabad, Pakistan" />

            <TextView
                android:id="@+id/tvReportedIntent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_intent_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/wedora_tag_text"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Divorced • Looking for Second Wife" />

            <TextView
                android:id="@+id/tvReportedBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4sp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Coffee, long walks and terrible puns." />

            <!-- Report -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/wedora_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_report_heading"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvReasonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/admin_report_reason_label"
                android:textColor="@color/wedora_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="14sp"
                tools:text="Sending inappropriate messages and photos repeatedly." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/admin_report_reporter_label"
                android:textColor="@color/wedora_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvReporterUid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                tools:text="ahmedKhanUid123abc456" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/admin_report_status_label"
                android:textColor="@color/wedora_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium"
                tools:text="Pending" />

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Actions ===== -->

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="@string/admin_action_dismiss"
            android:textColor="@color/wedora_accent"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_medium" />

        <!-- Never both visible at once — exactly one of these two shows,
             chosen at bind time by the reported user's own isBanned. -->

        <TextView
            android:id="@+id/btnBanUser"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_danger"
            android:gravity="center"
            android:text="@string/admin_action_ban"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_medium" />

        <TextView
            android:id="@+id/btnUnbanUser"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_success"
            android:gravity="center"
            android:text="@string/admin_action_unban"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_medium"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
