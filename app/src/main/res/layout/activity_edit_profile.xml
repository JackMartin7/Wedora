<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit Profile. Every field is pre-populated from the user's Firestore
    document; Save stays disabled until something actually differs from what
    was loaded, so the screen can't issue a no-op write.

    The photo is device-local (LocalProfilePrefs) rather than a Firestore
    field, so it saves on pick rather than on Save — see EditProfileActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/edit_profile_title"
        android:textColor="@color/wedora_text"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- Disabled until a change is detected; alpha is driven in code alongside
         isEnabled, since a TextView doesn't dim itself the way a button does. -->
    <TextView
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="@string/btn_save"
        android:textColor="@color/wedora_accent"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <View
        android:id="@+id/dividerTopBar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/wedora_border"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- ===== Photo ===== -->

            <!-- Same ShapeableImageView treatment as ProfileActivity's avatar,
                 so the two screens show the photo identically. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEditPhoto"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:layout_marginTop="24dp"
                android:elevation="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder"
                android:contentDescription="@string/cd_avatar"
                app:strokeColor="@color/wedora_accent"
                app:strokeWidth="4dp"
                app:shapeAppearanceOverlay="@style/WedoraCircleImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="@string/change_photo"
                android:textColor="@color/wedora_accent"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivEditPhoto" />

            <!-- ===== Full Name ===== -->

            <TextView
                android:id="@+id/labelName"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_full_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvChangePhoto" />

            <EditText
                android:id="@+id/etName"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName"
                android:imeOptions="actionNext"
                android:autofillHints="name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelName" />

            <!-- ===== Age ===== -->

            <TextView
                android:id="@+id/labelAge"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_age"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etName" />

            <EditText
                android:id="@+id/etAge"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_age"
                android:inputType="number"
                android:maxLength="3"
                android:imeOptions="actionNext"
                android:autofillHints=""
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelAge" />

            <!-- ===== Bio ===== -->

            <TextView
                android:id="@+id/labelBio"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_bio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAge" />

            <!-- gravity=top so the caret starts at the first line rather than
                 vertically centred in the taller box. -->
            <EditText
                android:id="@+id/etBio"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:gravity="top"
                android:paddingVertical="12dp"
                android:hint="@string/hint_bio"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="150"
                android:imeOptions="actionNone"
                android:autofillHints=""
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelBio" />

            <TextView
                android:id="@+id/tvBioCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etBio"
                tools:text="0 / 150" />

            <!-- ===== City ===== -->

            <TextView
                android:id="@+id/labelCity"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_city"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBioCounter" />

            <EditText
                android:id="@+id/etCity"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_city"
                android:inputType="textCapWords"
                android:imeOptions="actionNext"
                android:autofillHints="postalAddressLocality"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelCity" />

            <!-- ===== Country ===== -->

            <TextView
                android:id="@+id/labelCountry"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_country"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etCity" />

            <EditText
                android:id="@+id/etCountry"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_country"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:autofillHints="postalAddressCountry"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelCountry" />

            <!-- ===== Gender ===== -->

            <TextView
                android:id="@+id/labelGender"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_gender"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etCountry" />

            <LinearLayout
                android:id="@+id/rowGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelGender">

                <TextView
                    android:id="@+id/tvGenderMale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_male"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/tvGenderFemale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_female"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/tvGenderOther"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_other"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

            <!-- ===== Interested In ===== -->

            <TextView
                android:id="@+id/labelInterestedIn"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_interested_in"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowGender" />

            <LinearLayout
                android:id="@+id/rowInterestedIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelInterestedIn">

                <TextView
                    android:id="@+id/tvInterestedMale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_male"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/tvInterestedFemale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_female"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/tvInterestedOther"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segment_option_unselected"
                    android:gravity="center"
                    android:text="@string/gender_other"
                    android:textColor="@color/wedora_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

            <!-- ===== My Status ===== -->

            <TextView
                android:id="@+id/labelMyStatus"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_my_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowInterestedIn" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsMyStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelMyStatus" />

            <!-- ===== Looking For ===== -->
            <!-- Rebuilt whenever the gender selection changes. -->

            <TextView
                android:id="@+id/labelLookingFor"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_looking_for"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipsMyStatus" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsLookingFor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelLookingFor" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Covers the form while the initial load is in flight. -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
