<?xml version="1.0" encoding="utf-8"?>
<!--
    Explore: a "People Nearby" strip over a "Discover" grid, matching the layout
    language of the other tabs (plain theme background, bold title top-left, tab
    bar below). Both sections read data that already exists in Firestore — the
    user's matches for the strip, the same feed query as Home for the grid.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <!-- Title is centred within the icon band so it lines up with the search
         bar that replaces it. -->
    <TextView
        android:id="@+id/tvExploreTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="@string/explore_title"
        android:textColor="@color/wedora_text"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnFilter"
        app:layout_constraintBottom_toBottomOf="@id/btnFilter" />

    <!-- 16dp top margin matches the other tabs' top bars — the previous 8dp sat
         the whole row (and so the search bar) too tight under the status bar. -->
    <ImageButton
        android:id="@+id/btnFilter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_filter"
        android:tint="@color/wedora_text"
        android:contentDescription="@string/cd_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Marks non-default filters. Overlays the icon's top-end corner. -->
    <View
        android:id="@+id/filterDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_filter_dot"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/btnFilter"
        app:layout_constraintTop_toTopOf="@id/btnFilter" />

    <ImageButton
        android:id="@+id/btnSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_search"
        android:tint="@color/wedora_text"
        android:contentDescription="@string/cd_search"
        app:layout_constraintEnd_toStartOf="@id/btnFilter"
        app:layout_constraintTop_toTopOf="@id/btnFilter"
        app:layout_constraintBottom_toBottomOf="@id/btnFilter" />

    <!-- Search bar, overlaid on the top bar. Hidden until the search icon is
         tapped, then it takes over the row and filters the Discover grid. -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_input_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnFilter"
        app:layout_constraintBottom_toBottomOf="@id/btnFilter">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:tint="@color/wedora_text_secondary"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="@string/explore_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/wedora_text"
            android:textColorHint="@color/wedora_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:autofillHints="" />

        <ImageButton
            android:id="@+id/btnSearchClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/wedora_text_secondary"
            android:contentDescription="@string/cd_close_search" />

    </LinearLayout>

    <!-- ===== Scrolling content ===== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/exploreScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btnFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: People Nearby -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/explore_nearby_label"
                    android:textColor="@color/wedora_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvNearbySeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:text="@string/explore_see_all"
                    android:textColor="@color/wedora_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal"
                android:scrollbars="none"
                tools:listitem="@layout/item_explore_nearby" />

            <TextView
                android:id="@+id/tvNearbyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:text="@string/explore_nearby_empty"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Section 2: Discover -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/explore_discover_label"
                    android:textColor="@color/wedora_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvDiscoverSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:text="@string/explore_see_all"
                    android:textColor="@color/wedora_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDiscover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="14dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_discover_grid" />

            <!-- Shown only when the preview above is truncating something —
                 see ExploreActivity.showDiscover. Same destination as See
                 All above, just a second, closer-at-hand way to reach it. -->
            <TextView
                android:id="@+id/btnDiscoverLoadMore"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:text="@string/explore_load_more"
                android:textColor="@color/wedora_accent"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressDiscover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/wedora_accent"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Discover empty state: message + a shortcut to the filters. -->
            <include
                android:id="@+id/discoverEmpty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Bottom navigation ===== -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
