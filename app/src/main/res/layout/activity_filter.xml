<?xml version="1.0" encoding="utf-8"?>
<!--
    Feed filters. Age is the only section that narrows the query today;
    relationship type and distance are stored and restored but inert — see
    FilterActivity and FilterPrefs.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/action_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/filter_title"
        android:textColor="@color/wedora_text"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/btnClose"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose" />

    <TextView
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="@string/filter_reset"
        android:textColor="@color/wedora_accent"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose" />

    <!-- No rule under the header: the reference separates the bar from the
         content with space alone. The ScrollView therefore anchors straight to
         btnClose and carries the gap the divider used to sit in. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintBottom_toTopOf="@id/btnApply">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ===== Age range ===== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/filter_age_range"
                style="@style/WedoraSectionHeader" />

            <TextView
                android:id="@+id/tvAgeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/wedora_accent"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                tools:text="18 – 40" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/sliderAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:valueFrom="18"
                android:valueTo="80"
                android:stepSize="1"
                app:thumbColor="@color/wedora_accent"
                app:trackColorActive="@color/wedora_accent"
                app:trackColorInactive="@color/wedora_input_border"
                app:thumbRadius="11dp"
                app:thumbStrokeColor="@color/wedora_bg"
                app:thumbStrokeWidth="3dp"
                app:trackHeight="6dp"
                app:labelBehavior="gone" />

            <!--
                Active today. A toggle rather than a chip because it is a
                single on/off narrowing, and it sits right after Age to match
                the reference's ordering.

                NOT labelled "Online Now" on purpose: the window behind it is
                24h (OnlineStatus.ACTIVE_WINDOW_MS) while the presence dots use
                five minutes, so someone can pass this filter and correctly
                show no dot. The label says what the filter actually does.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WedoraSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_active_today" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/filter_active_today_subtitle"
                        android:textColor="@color/wedora_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchActiveToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- ===== Status ===== -->
            <!-- Options depend on the gender of the people being filtered, so
                 the chips are built in code once that's known. -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/filter_by_status"
                style="@style/WedoraSectionHeader" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsStatusFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleLine="false"
                app:singleSelection="false"
                app:chipSpacingHorizontal="8dp" />

            <!-- ===== Looking For ===== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/filter_by_looking_for"
                style="@style/WedoraSectionHeader" />

            <!-- Shown while the gender that decides these options is loading, so
                 the wrong chips can't flash up first. Swapped for the chips once
                 the read lands. -->
            <ProgressBar
                android:id="@+id/progressLookingFor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/wedora_accent"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsLookingForFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:singleLine="false"
                app:singleSelection="false"
                app:chipSpacingHorizontal="8dp" />

            <!--
                Country. The options are NOT a fixed country list - they are
                the distinct countries actually present in this viewer's
                candidate pool, filled in by FilterActivity once the feed
                loads.

                That is deliberate. `country` is free text on the profile, and
                the pool currently holds both "USA" and "United States" for the
                same place, so matching a canonical list against it would
                silently miss people. Offering exactly what is stored means the
                filter always matches, at the cost of a list that shows those
                duplicates until the stored data is normalised - separate work.
            -->
            <TextView
                style="@style/WedoraSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/filter_by_country" />

            <!--
                Opens CountryPickerBottomSheet rather than a dropdown. It used
                to be a MaterialAutoCompleteTextView fed from the cached pool;
                the picker replaced that because it is searchable, shows flags,
                and offers the canonical list instead of whatever free text
                happened to be stored.

                A plain TextView, not an ExposedDropdownMenu box: that widget
                installs its own click handler to toggle a dropdown, which
                fights a click listener that wants to open a sheet instead.
            -->
            <TextView
                android:id="@+id/inputCountry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:drawableTint="@color/wedora_text_secondary"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/wedora_text"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                tools:text="🇵🇰  Pakistan" />

            <!-- ===== Distance ===== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/filter_distance"
                style="@style/WedoraSectionHeader" />

            <TextView
                android:id="@+id/tvDistanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/wedora_accent"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                tools:text="Within 50 km" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:valueFrom="1"
                android:valueTo="20020"
                android:stepSize="1"
                app:thumbColor="@color/wedora_accent"
                app:trackColorActive="@color/wedora_accent"
                app:trackColorInactive="@color/wedora_input_border"
                app:thumbRadius="11dp"
                app:thumbStrokeColor="@color/wedora_bg"
                app:thumbStrokeWidth="3dp"
                app:trackHeight="6dp"
                app:labelBehavior="gone" />

            <!-- ===== Interests ===== -->
            <!-- Stored and restored like the rest of this screen, but not
                 currently applied to the feed query — see FilterActivity and
                 Feed.kt. Placed last since, unlike the sections above, it
                 doesn't narrow anything yet. -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/filter_by_interests"
                style="@style/WedoraSectionHeader" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsInterestsFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleLine="false"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnApply"
        style="@style/WedoraFilterApplyButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/filter_apply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
