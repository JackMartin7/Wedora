<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMyAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/home_me_avatar"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_avatar"
        app:shapeAppearanceOverlay="@style/WedoraCircleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/home_greeting_morning"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/ivMyAvatar"
        app:layout_constraintTop_toTopOf="@id/ivMyAvatar"
        app:layout_constraintBottom_toTopOf="@id/tvUserName"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/home_sample_name"
        android:textColor="@color/wedora_text"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/ivMyAvatar"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting"
        app:layout_constraintBottom_toBottomOf="@id/ivMyAvatar" />

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_notification_bell"
        android:contentDescription="@string/cd_notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivMyAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivMyAvatar" />

    <!-- Unseen-like count, overlaying the bell's top-end corner. Stays hidden
         until commit 2 wires it to a real query. -->
    <TextView
        android:id="@+id/tvNotificationBadge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:gravity="center"
        android:paddingHorizontal="5dp"
        android:background="@drawable/bg_unread_badge"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="3"
        app:layout_constraintEnd_toEndOf="@id/btnNotifications"
        app:layout_constraintTop_toTopOf="@id/btnNotifications" />

    <ImageButton
        android:id="@+id/btnDarkMode"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dark_mode"
        android:contentDescription="@string/cd_dark_mode_toggle"
        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
        app:layout_constraintTop_toTopOf="@id/ivMyAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivMyAvatar" />

    <!-- ===== Feed ===== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatches"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/ivMyAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintTop_toBottomOf="@id/ivMyAvatar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:gravity="center"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ivMyAvatar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Bottom navigation ===== -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
