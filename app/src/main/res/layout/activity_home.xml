<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <!--
        Avatar + greeting + name are one tap target to Profile, so they're
        wrapped rather than given three separate listeners — a shared container
        gets one ripple across the whole area instead of three that light up
        depending on which word was hit.

        Geometry is unchanged: the container's 16dp start margin plus 4dp start
        padding puts the avatar at the same 20dp as before, and its height is
        still the avatar's 40dp, so everything anchored to it below sits where
        it did. The padding exists purely to give the ripple a little bleed
        around the content.
    -->
    <LinearLayout
        android:id="@+id/greetingContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/topBarIconBarrier"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            Avatar, accent ring and online dot as one 48dp stack. The ring is
            a sibling View rather than a stroke on the ShapeableImageView so
            it can sit OUTSIDE the photo instead of eating 2dp of it, and the
            dot overlaps the ring's bottom-right exactly as the design shows.
            ivMyAvatar keeps its id and its centerCrop/circle treatment, so
            HomeActivity's binding and both photo-load call sites are
            unaffected.
        -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivMyAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:src="@drawable/home_me_avatar"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_avatar"
                app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_v2_avatar_ring" />

            <View
                android:id="@+id/myOnlineDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_v2_online_dot" />

        </FrameLayout>

        <!-- 0dp + weight so the text column takes exactly the space left after
             the avatar, which is what gives the labels a bounded width to
             ellipsize against. At wrap_content they'd measure their full
             length and push past the container. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/home_greeting_morning"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/home_sample_name"
                android:textColor="@color/wedora_text"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />

        </LinearLayout>

    </LinearLayout>

    <!--
        Premium. Tinted accent rather than shipping a second crown asset: the
        drawable is white so it can sit on the gradient banners, and the tint
        recolours it for this light background.
    -->
    <!--
        The start edge of the whole right-hand icon group. The greeting ends
        here rather than at any one icon, so hiding or adding an icon later
        moves the boundary automatically instead of leaving the text
        constrained to something that's no longer leftmost.

        barrierAllowsGoneWidgets is false so a hidden icon stops counting —
        otherwise the greeting would keep reserving space for it.
    -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarIconBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="btnDarkMode,btnNotifications,btnPremium,btnFilter" />

    <ImageButton
        android:id="@+id/btnFilter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_filter"
        android:tint="@color/wedora_text_secondary"
        android:contentDescription="@string/cd_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/greetingContainer"
        app:layout_constraintBottom_toBottomOf="@id/greetingContainer" />

    <!-- Marks non-default filters. Overlays the icon's top-end corner. -->
    <View
        android:id="@+id/filterDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:background="@drawable/bg_filter_dot"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@id/btnFilter"
        app:layout_constraintTop_toTopOf="@id/btnFilter" />

    <ImageButton
        android:id="@+id/btnPremium"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_crown"
        android:tint="@color/wedora_gold"
        android:contentDescription="@string/cd_premium"
        app:layout_constraintEnd_toStartOf="@id/btnFilter"
        app:layout_constraintTop_toTopOf="@id/greetingContainer"
        app:layout_constraintBottom_toBottomOf="@id/greetingContainer" />

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_notification_bell"
        android:contentDescription="@string/cd_notifications"
        app:layout_constraintEnd_toStartOf="@id/btnPremium"
        app:layout_constraintTop_toTopOf="@id/greetingContainer"
        app:layout_constraintBottom_toBottomOf="@id/greetingContainer" />

    <!-- Unseen-like count, overlaying the bell's top-end corner. Stays hidden
         until commit 2 wires it to a real query. -->
    <TextView
        android:id="@+id/tvNotificationBadge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:gravity="center"
        android:paddingHorizontal="5dp"
        android:background="@drawable/bg_unread_badge"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="3"
        app:layout_constraintEnd_toEndOf="@id/btnNotifications"
        app:layout_constraintTop_toTopOf="@id/btnNotifications" />

    <ImageButton
        android:id="@+id/btnDarkMode"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dark_mode"
        android:contentDescription="@string/cd_dark_mode_toggle"
        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
        app:layout_constraintTop_toTopOf="@id/greetingContainer"
        app:layout_constraintBottom_toBottomOf="@id/greetingContainer" />

    <!--
        Location nudge. Shown only to the signed-in user themselves when their
        own profile has no latitude/longitude — re-evaluated on every Home
        load, not a one-time dismissible banner. Reuses the guest button's
        outline treatment rather than the warning-box style used elsewhere,
        per the approved design. Starts GONE; HomeActivity toggles it once it
        knows whether self.latitude/longitude are set.
    -->
    <LinearLayout
        android:id="@+id/bannerLocationPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:background="@drawable/bg_button_guest_outline"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/greetingContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/wedora_accent"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/home_location_banner_text"
            android:textColor="@color/wedora_accent"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_medium" />

    </LinearLayout>

    <!-- ===== Feed (swipeable card stack) ===== -->

    <com.wedora.app.SwipeCardStackView
        android:id="@+id/cardStack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/bannerLocationPrompt"
        app:layout_goneMarginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <!-- Skeleton cards, filled by HomeActivity while the feed query runs. -->
    <LinearLayout
        android:id="@+id/skeletonFeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/bannerLocationPrompt"
        app:layout_goneMarginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintTop_toBottomOf="@id/bannerLocationPrompt"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bannerLocationPrompt"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Bottom navigation ===== -->

    <!--
        itemMinHeight 64dp: 56dp is Material's design_bottom_navigation_height
        default and reads as too thin. 64dp is what Figma 118:506 specifies -
        its content container sits at y=17 with height 47, so content ends at
        64. The rest of the board's 102dp bar is an iPhone home indicator,
        which on Android is the system gesture inset that
        applyBottomNavScreenInsets already pads for.

        itemMinHeight rather than a fixed layout_height: that inset is applied
        as padding INSIDE this view, so a fixed height would be eaten by it on
        a gesture-nav device. Growing the item also grows the touch target,
        which padding would not.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemIconSize="20dp"
        app:itemMinHeight="64dp"
        app:itemTextAppearanceActive="@style/WedoraNavLabel"
        app:itemTextAppearanceInactive="@style/WedoraNavLabel"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!--
        Update-download hairline. What remains once the user taps "Continue in
        background" on the download dialog — the download keeps running under
        Play, and this 3dp mirror of the same progress is the only remaining
        indicator. Both views start GONE; HomeActivity shows them while
        UpdateState is Downloading.

        Pinned to the very top of the window (above the status-bar inset) on
        purpose: it is chrome about the app itself, not about Home's content,
        and it must not shift Home's layout when it appears.
    -->
    <View
        android:id="@+id/updateHairlineTrack"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/wedora_input_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/updateHairlineFill"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/wedora_accent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0"
        app:layout_constraintWidth_default="percent" />

</androidx.constraintlayout.widget.ConstraintLayout>
