<?xml version="1.0" encoding="utf-8"?>
<!--
    The Likes tab.

    Count, the locked "featured" teaser, the upgrade banner and the rest of the
    grid all scroll together inside one NestedScrollView — the grid has nested
    scrolling off and wraps its content, so the page moves as a whole rather
    than the list scrolling inside a fixed frame beneath the banner.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- Title only — no back arrow, this is a bottom-nav destination. -->
    <TextView
        android:id="@+id/tvLikesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/likes_title"
        android:textColor="@color/wedora_text"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        "Users Matched" strip. Independent of the likes grid below — it cares
        about the match count, not the like count, so it stays up even when
        LikesActivity's own empty state hides likesScroll (no likes, but
        matches exist). Hidden entirely (LikesActivity) rather than shown with
        an empty strip when there are zero matches; the divider lives inside
        this section so it disappears along with everything else.
    -->
    <LinearLayout
        android:id="@+id/usersMatchedSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tvLikesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/likes_users_matched_label"
            android:textColor="@color/wedora_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsersMatched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:orientation="horizontal"
            android:scrollbars="none"
            tools:listitem="@layout/item_likes_matched_user" />

        <!-- Separates this section from the likes grid below. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/wedora_border" />

    </LinearLayout>

    <!--
        "Who Viewed Your Profile" strip. Premium-only and hidden entirely for
        everyone else, same as this data is hidden everywhere it appears
        (ProfileViewersActivity's own gate) — no teaser here, since unlike the
        likes grid this strip is a bonus preview, not the feature's main
        upgrade hook. Hidden with zero views too, same pattern as
        usersMatchedSection above. A shortcut into the full list
        (ProfileViewersActivity), same relationship usersMatchedSection has to
        MatchHistoryActivity.
    -->
    <LinearLayout
        android:id="@+id/profileViewersSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/usersMatchedSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/likes_profile_viewers_label"
            android:textColor="@color/wedora_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfileViewers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:orientation="horizontal"
            android:scrollbars="none"
            tools:listitem="@layout/item_likes_matched_user" />

        <!-- Free-tier version of the row above: LikesActivity.showLockedProfileViewers
             fills this with a few static blurred-avatar-and-lock tiles instead
             of rvProfileViewers' real data — same "no fetch, no real data
             needed, always shown" shape as ProfileViewersActivity's own free
             teaser (see that Activity's showTeaser/buildFeaturedTiles).
             Starts GONE; only one of this or rvProfileViewers is ever visible
             at a time. -->
        <LinearLayout
            android:id="@+id/profileViewersLockedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Separates this section from the likes grid below. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/wedora_border" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/likesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/profileViewersSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Skeleton tiles, filled by LikesActivity while the read runs. -->
            <LinearLayout
                android:id="@+id/skeletonLikes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/wedora_text"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="7 people liked you" />

            <!-- Two locked tiles, added by LikesActivity. -->
            <LinearLayout
                android:id="@+id/featuredContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLikes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
        Guest-only sticky sign-up prompt. Sits outside likesScroll, anchored
        straight to bottomNav, so it never moves while the blurred teaser
        above scrolls underneath it. Starts GONE.
    -->
    <LinearLayout
        android:id="@+id/guestSignUpBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_premium_card"
        android:elevation="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_crown"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/premium_banner_guest"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/poppins_medium" />

        <TextView
            android:id="@+id/btnGuestSignUpBannerAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_on_accent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/premium_banner_signup_action"
            android:textColor="@color/wedora_accent"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_semibold" />

    </LinearLayout>

    <!-- Anchored below profileViewersSection, not tvLikesTitle directly —
         either of the strips above can be visible over them, and anchoring to
         the title would have them render underneath/over it instead of below
         both. -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/profileViewersSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/profileViewersSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        itemMinHeight 64dp: 56dp is Material's design_bottom_navigation_height
        default and reads as too thin. 64dp is what Figma 118:506 specifies -
        its content container sits at y=17 with height 47, so content ends at
        64. The rest of the board's 102dp bar is an iPhone home indicator,
        which on Android is the system gesture inset that
        applyBottomNavScreenInsets already pads for.

        itemMinHeight rather than a fixed layout_height: that inset is applied
        as padding INSIDE this view, so a fixed height would be eaten by it on
        a gesture-nav device. Growing the item also grows the touch target,
        which padding would not.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemIconSize="20dp"
        app:itemMinHeight="64dp"
        app:itemTextAppearanceActive="@style/WedoraNavLabel"
        app:itemTextAppearanceInactive="@style/WedoraNavLabel"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
