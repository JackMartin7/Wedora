<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="52dp"
            android:background="@null"
            android:src="@drawable/ic_back"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_title"
            android:textColor="@color/wedora_accent"
            android:textSize="26sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Illustration -->
        <ImageView
            android:id="@+id/ivLoginIllustration"
            android:layout_width="235dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_login_illustration"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- Email field -->
        <TextView
            android:id="@+id/labelEmail"
            style="@style/WedoraFieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLoginIllustration" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/WedoraInputField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelEmail" />

        <!-- Password field -->
        <TextView
            android:id="@+id/labelPassword"
            style="@style/WedoraFieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etEmail" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/WedoraInputField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:paddingEnd="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelPassword" />

        <ImageButton
            android:id="@+id/btnTogglePassword"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:background="@null"
            android:src="@drawable/ic_hide"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="@id/etPassword"
            app:layout_constraintTop_toTopOf="@id/etPassword"
            app:layout_constraintBottom_toBottomOf="@id/etPassword" />

        <!-- Remember me / Forgot password row -->
        <CheckBox
            android:id="@+id/cbRememberMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/remember_me"
            android:textColor="@color/wedora_text"
            android:textSize="12sp"
            android:buttonTint="@color/wedora_text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPassword" />

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password"
            android:textColor="@color/wedora_accent"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cbRememberMe"
            app:layout_constraintBottom_toBottomOf="@id/cbRememberMe" />

        <!-- Login button.
             Explicitly AppCompatButton: under a Theme.MaterialComponents.* theme a
             plain <Button> is auto-inflated as MaterialButton, which manages its own
             background and ignores android:background (our ripple/corners/shadow). -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            style="@style/WedoraPrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:text="@string/btn_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cbRememberMe" />

        <!-- Divider "Or continue with" -->
        <View
            android:id="@+id/dividerLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/wedora_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDividerOr"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintBottom_toBottomOf="@id/tvDividerOr" />

        <TextView
            android:id="@+id/tvDividerOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="@string/auth_divider_or"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/dividerLeft"
            app:layout_constraintEnd_toStartOf="@id/dividerRight"
            app:layout_constraintTop_toBottomOf="@id/btnLogin" />

        <View
            android:id="@+id/dividerRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/wedora_border"
            app:layout_constraintStart_toEndOf="@id/tvDividerOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDividerOr"
            app:layout_constraintBottom_toBottomOf="@id/tvDividerOr" />

        <!-- Google sign-in -->
        <TextView
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_google"
            android:gravity="center"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="10dp"
            android:paddingHorizontal="16dp"
            android:text="@string/btn_continue_with_google"
            android:textColor="@color/wedora_text"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDividerOr" />

        <!-- Sign up prompt -->
        <TextView
            android:id="@+id/tvSignUpPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGoogle" />

        <!-- Continue as Guest -->
        <TextView
            android:id="@+id/tvContinueAsGuest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/continue_as_guest"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSignUpPrompt" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <include
        android:id="@+id/authLoading"
        layout="@layout/layout_auth_loading_overlay" />

</FrameLayout>
