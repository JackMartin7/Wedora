<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="52dp"
            android:background="@null"
            android:src="@drawable/ic_back"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Brand mark -->
        <ImageView
            android:id="@+id/ivAuthMark"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_badge_heart"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/login_title"
            android:textColor="@color/wedora_text"
            android:textSize="26sp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAuthMark" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Card: everything interactive lives inside one elevated surface,
             Google-first per the design language every other auth-adjacent
             surface this session (the Google loading overlay) already
             follows. Nesting doesn't touch a single Kotlin reference — every
             id below is unchanged, LoginActivity binds them exactly as before. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/authCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:padding="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

            <!-- Google sign-in -->
            <TextView
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_google"
                android:gravity="center"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="10dp"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_continue_with_google"
                android:textColor="@color/wedora_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Divider "Or continue with" -->
            <View
                android:id="@+id/dividerLeft"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/wedora_border"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvDividerOr"
                app:layout_constraintTop_toBottomOf="@id/btnGoogle"
                app:layout_constraintBottom_toBottomOf="@id/tvDividerOr" />

            <TextView
                android:id="@+id/tvDividerOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/auth_divider_or"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/dividerLeft"
                app:layout_constraintEnd_toStartOf="@id/dividerRight"
                app:layout_constraintTop_toBottomOf="@id/btnGoogle" />

            <View
                android:id="@+id/dividerRight"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/wedora_border"
                app:layout_constraintStart_toEndOf="@id/tvDividerOr"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDividerOr"
                app:layout_constraintBottom_toBottomOf="@id/tvDividerOr" />

            <!-- Email field -->
            <TextView
                android:id="@+id/labelEmail"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDividerOr" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelEmail" />

            <!-- Password field -->
            <TextView
                android:id="@+id/labelPassword"
                style="@style/WedoraFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etEmail" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/WedoraInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:paddingEnd="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelPassword" />

            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:src="@drawable/ic_hide"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="@id/etPassword"
                app:layout_constraintTop_toTopOf="@id/etPassword"
                app:layout_constraintBottom_toBottomOf="@id/etPassword" />

            <!-- Remember me / Forgot password row -->
            <CheckBox
                android:id="@+id/cbRememberMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/remember_me"
                android:textColor="@color/wedora_text"
                android:textSize="12sp"
                android:buttonTint="@color/wedora_text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etPassword" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="@color/wedora_accent"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/cbRememberMe"
                app:layout_constraintBottom_toBottomOf="@id/cbRememberMe" />

            <!-- Login button.
                 Explicitly AppCompatButton: under a Theme.MaterialComponents.* theme a
                 plain <Button> is auto-inflated as MaterialButton, which manages its own
                 background and ignores android:background (our ripple/corners/shadow). -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/WedoraPrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/btn_login"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbRememberMe" />

            <!-- Small "or" divider between Login and the guest button — lighter
                 weight than the card's "Or continue with" divider above, since
                 this one separates two ways into the SAME screen rather than
                 two different auth providers. -->
            <View
                android:id="@+id/dividerGuestLeft"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/wedora_border"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvGuestDividerOr"
                app:layout_constraintTop_toBottomOf="@id/btnLogin"
                app:layout_constraintBottom_toBottomOf="@id/tvGuestDividerOr" />

            <TextView
                android:id="@+id/tvGuestDividerOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/auth_divider_or_lowercase"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/dividerGuestLeft"
                app:layout_constraintEnd_toStartOf="@id/dividerGuestRight"
                app:layout_constraintTop_toBottomOf="@id/btnLogin" />

            <View
                android:id="@+id/dividerGuestRight"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/wedora_border"
                app:layout_constraintStart_toEndOf="@id/tvGuestDividerOr"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvGuestDividerOr"
                app:layout_constraintBottom_toBottomOf="@id/tvGuestDividerOr" />

            <!-- Continue as Guest — the one guest entry point on this screen
                 (see the removed plain-text link that used to sit below the
                 card). Outlined/tinted rather than solid, so it reads as a
                 secondary action next to Login's solid accent fill. Two lines:
                 label (with a person icon) and a muted subtitle underneath. -->
            <LinearLayout
                android:id="@+id/btnContinueAsGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_button_guest_outline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGuestDividerOr"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_account"
                        android:tint="@color/wedora_accent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_as_guest"
                        android:textColor="@color/wedora_accent"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_as_guest_subtitle"
                    android:textColor="@color/wedora_accent"
                    android:alpha="0.7"
                    android:textSize="10sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sign up prompt -->
        <TextView
            android:id="@+id/tvSignUpPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/authCard"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <include
        android:id="@+id/authLoading"
        layout="@layout/layout_auth_loading_overlay" />

</FrameLayout>
