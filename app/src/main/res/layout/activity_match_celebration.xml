<?xml version="1.0" encoding="utf-8"?>
<!--
    The "It's mutual" moment. Copy matches the push the Cloud Function sends
    verbatim, so the notification and this screen say the same thing.

    Full-bleed accent over the page colour rather than a bottom sheet: this
    marks the one transition that now unlocks a conversation, and a sheet would
    read as another dismissible prompt among the app's several.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <ImageView
        android:id="@+id/ivCelebrationSpark"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_sparkle_heart"
        android:tint="@color/wedora_accent"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/avatarRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Both faces, overlapping slightly so the pair reads as one unit. -->
    <LinearLayout
        android:id="@+id/avatarRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivCelebrationSpark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCelebrationSelf"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder"
            android:contentDescription="@null"
            app:strokeColor="@color/wedora_accent"
            app:strokeWidth="2dp"
            app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCelebrationOther"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="-20dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder"
            android:contentDescription="@null"
            app:strokeColor="@color/wedora_accent"
            app:strokeWidth="2dp"
            app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCelebrationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/match_celebration_title"
        android:textColor="@color/wedora_text"
        android:textSize="28sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintTop_toBottomOf="@id/avatarRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCelebrationSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="40dp"
        android:gravity="center"
        android:lineSpacingExtra="4sp"
        android:text="@string/match_celebration_subtitle"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvCelebrationTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCelebrationMessage"
        style="@style/WedoraPrimaryButton"
        android:layout_width="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/match_celebration_message"
        app:layout_constraintBottom_toTopOf="@id/btnCelebrationKeep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnCelebrationKeep"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/match_celebration_keep"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
