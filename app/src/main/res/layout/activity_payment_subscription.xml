<?xml version="1.0" encoding="utf-8"?>
<!--
    Payment & Subscription. Nothing here transacts: the plan cards and the
    Subscribe button are presentation only until billing is wired up, and both
    actions land on a "Coming Soon" dialog. See PaymentSubscriptionActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Top bar ===== -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/settings_payment"
        android:textColor="@color/wedora_text"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp"
            android:clipToPadding="false">

            <!--
                Shown instead of everything below once isPremium == true — no
                pricing cards, no Subscribe button, just a status confirmation.
                Starts GONE; PaymentSubscriptionActivity toggles this against
                upgradeSection based on the loaded profile.
            -->
            <LinearLayout
                android:id="@+id/premiumMemberSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_crown"
                    android:background="@drawable/bg_premium_card"
                    android:padding="16dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/plan_premium_member_title"
                    android:textColor="@color/wedora_text"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/plan_premium_member_subtitle"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="@string/plan_manage_subscription_note"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ===== Everything below is the upgrade flow — hidden entirely
                 once isPremium == true, in favor of premiumMemberSection
                 above. ===== -->
            <LinearLayout
                android:id="@+id/upgradeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- ===== Current plan ===== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_current_label"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/plan_free"
                        android:textColor="@color/wedora_text"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_basic"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/plan_badge_basic"
                        android:textColor="@color/wedora_text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/plan_upgrade_pitch"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3sp" />

            </LinearLayout>

            <!-- ===== Plan choices ===== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/plan_premium_plans"
                android:textColor="@color/wedora_text"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Monthly -->
                <LinearLayout
                    android:id="@+id/cardMonthly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_plan_unselected"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvMonthlyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/plan_monthly_title"
                        android:textColor="@color/wedora_text"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:id="@+id/tvMonthlyPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:text="@string/plan_monthly_price"
                        android:textColor="@color/wedora_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Yearly. The badge sits in a FrameLayout over cardYearly,
                     positioned within the row's normal bounds (no negative
                     margin — that used to poke it above the FrameLayout's
                     parent LinearLayout, which clips children by default and
                     was chopping the badge's own top off). cardYearly's own
                     paddingTop is inflated well past the badge's rendered
                     height so its title/price never sit underneath it,
                     regardless of the badge's exact size or the card's
                     width. -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">

                    <LinearLayout
                        android:id="@+id/cardYearly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_plan_selected"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvYearlyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/plan_yearly_title"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/tvYearlyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:text="@string/plan_yearly_price"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- ===== Features ===== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/plan_features_title"
                android:textColor="@color/wedora_text"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Rows inflated here by PaymentSubscriptionActivity -->
            <LinearLayout
                android:id="@+id/featureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- ===== Subscribe ===== -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubscribe"
                    style="@style/WedoraPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/plan_subscribe" />

                <!-- Shown instead of btnSubscribe's label while a purchase is
                     in flight — the button itself is disabled, not hidden, so
                     its bounds don't jump. -->
                <ProgressBar
                    android:id="@+id/progressSubscribe"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/plan_subscribe_caption"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRestorePurchase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="@string/plan_restore_purchase"
                android:textColor="@color/wedora_accent"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
