<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <!-- ===== Header ===== -->

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/profile_title"
        android:textColor="@color/wedora_text"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_history"
        android:contentDescription="@string/cd_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvProfileTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvProfileTitle" />

    <!-- ===== Scrollable content ===== -->

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvProfileTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <!-- Scrollable content — allow shadow to bleed outside without clipping. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- Photo / name / location / edit button -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:elevation="6dp"
                android:src="@drawable/profile_photo"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_avatar"
                app:strokeColor="@color/wedora_avatar_ring"
                app:strokeWidth="3dp"
                app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="@string/profile_sample_name"
                android:textColor="@color/wedora_text"
                android:textSize="19sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Guest-only. Starts GONE; shown only for guests, in place of
                 tvProfileEmail/tvProfileAgeLocation below (neither applies —
                 a guest has no account data to show a line about). -->
            <TextView
                android:id="@+id/tvGuestSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/guest_profile_subtitle"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Guest-only, same styling as the signed-in tvProfileIntent
                 pill below. Starts GONE; ProfileActivity only shows it when
                 GuestPrefs has both a gender and an interestedIn value —
                 there's currently no screen that collects either from a
                 guest, so in practice this stays hidden until one exists. -->
            <TextView
                android:id="@+id/tvGuestGenderPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_intent_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/wedora_tag_text"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:text="Male • Looking for Female"
                tools:visibility="visible" />

            <!-- Real Firebase email; hidden for guests, who have none -->
            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="sarah@example.com" />

            <!-- Real "{age} years old • {city}, {country}" from the user's
                 Firestore doc; hidden until Complete Profile has populated it. -->
            <TextView
                android:id="@+id/tvProfileAgeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="18 years old • Islamabad, Pakistan"
                tools:visibility="visible" />

            <!-- "Divorced • Looking for Second Wife"; hidden until the
                 completion gate has collected both. -->
            <TextView
                android:id="@+id/tvProfileIntent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_intent_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/wedora_tag_text"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:text="Divorced • Looking for Second Wife"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/profile_edit_button"
                android:textColor="@color/wedora_accent"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <!--
                Guest-only. Replaces btnEditProfile above (never shown
                together — a guest has no profile to edit) with a full-width
                filled CTA rather than the signed-in outline pill, so the
                one action a guest actually can take reads as the prominent
                one. Starts GONE; ProfileActivity shows it only for guests.
            -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuestSignUp"
                style="@style/WedoraPrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:text="@string/guest_sign_up_now"
                android:visibility="gone" />

            <!--
                Stands in for the stats card while Firestore loads. The name,
                email and photo are not covered: they come from the Auth
                session and local storage, so they are already on screen and a
                placeholder would replace real content.
            -->
            <include
                android:id="@+id/skeletonProfile"
                layout="@layout/view_skeleton_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Stats card -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <!--
                    Each column is a FrameLayout, not a plain LinearLayout, so
                    a guest's lock badge can sit over the corner of its own
                    column rather than needing a separate overlay pass across
                    the whole card. The badge and the column's own click
                    listener are both guest-only, set in ProfileActivity.
                -->
                <FrameLayout
                    android:id="@+id/statColumnMatches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvStatMatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_placeholder"
                            tools:text="128"
                            android:textColor="@color/wedora_text"
                            android:textSize="18sp"
                            android:fontFamily="@font/poppins_semibold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/profile_stat_matches_label"
                            android:textColor="@color/wedora_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivStatLockMatches"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/wedora_text_secondary"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                </FrameLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/wedora_border" />

                <FrameLayout
                    android:id="@+id/statColumnLikes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvStatLikes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_placeholder"
                            tools:text="342"
                            android:textColor="@color/wedora_text"
                            android:textSize="18sp"
                            android:fontFamily="@font/poppins_semibold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/profile_stat_likes_label"
                            android:textColor="@color/wedora_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivStatLockLikes"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/wedora_text_secondary"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                </FrameLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/wedora_border" />

                <FrameLayout
                    android:id="@+id/statColumnProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvStatProfilePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_placeholder"
                            tools:text="86%"
                            android:textColor="@color/wedora_text"
                            android:textSize="18sp"
                            android:fontFamily="@font/poppins_semibold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/profile_stat_percent_label"
                            android:textColor="@color/wedora_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivStatLockProfile"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/wedora_text_secondary"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!--
                Guest-only CTA banner. Sits directly below the stats card,
                above the settings list — deliberately flatter and softer
                than the gradient premium card below (which guests never
                see: cardPremium/premiumMemberBadge both stay GONE for a
                guest), since this is an encouraging preview rather than an
                upsell to someone who's already signed in. Starts GONE;
                ProfileActivity shows it only for guests.
            -->
            <LinearLayout
                android:id="@+id/guestCtaBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_guest_cta_banner"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_sparkle_heart"
                    app:tint="@color/wedora_accent"
                    android:contentDescription="@null" />

                <!--
                    Text set in ProfileActivity as a SpannableString — the
                    body copy plus a trailing clickable "Sign Up" span, so the
                    link reads inline with the sentence like the design rather
                    than as a separate button bolted on the end.
                -->
                <TextView
                    android:id="@+id/tvGuestCtaText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:lineSpacingExtra="3sp"
                    android:textColor="@color/wedora_text"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <!--
                Premium upgrade gradient card. Sits between the stats and the
                settings list. Tappable for opening payment/subscription flow.

                Fixed height (56dp) with proper padding so content fits perfectly
                and the gradient background displays at full beauty. Hidden for
                guests (no account to upgrade).
            -->
            <LinearLayout
                android:id="@+id/cardPremium"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_premium_card"
                android:elevation="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Crown icon: white, 24dp -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_crown"
                    android:contentDescription="@null"
                    android:tint="@color/white" />

                <!-- Title: "Upgrade to Premium" bold white, flex width -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/premium_upgrade_title"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="@font/poppins_semibold" />

                <!-- CTA: "Unlock all features →" white, right-aligned -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/premium_upgrade_cta"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:gravity="end" />

            </LinearLayout>

            <!--
                Shown instead of cardPremium once isPremium == true — a plain
                status indicator, not a button: no click listener, no CTA.
                Same slot/margins as cardPremium so swapping visibility between
                the two doesn't shift anything else on the screen. Starts GONE;
                ProfileActivity toggles the pair based on the loaded profile.
            -->
            <LinearLayout
                android:id="@+id/premiumMemberBadge"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_premium_card"
                android:elevation="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_crown"
                    android:contentDescription="@null"
                    android:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/premium_member_badge"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="@font/poppins_semibold" />

            </LinearLayout>

            <!-- Dark Mode row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_icon_pink_square"
                    android:src="@drawable/ic_dark_mode"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/settings_dark_mode"
                    android:textColor="@color/wedora_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDarkMode"
                    style="@style/WedoraSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Remaining rows inflated here by ProfileActivity -->
            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Guest-only. Starts GONE; shown only for guests. -->
            <TextView
                android:id="@+id/tvGuestLogIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="@string/guest_already_have_account"
                android:textColor="@color/wedora_accent"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== Bottom navigation ===== -->

    <!--
        itemMinHeight 64dp: 56dp is Material's design_bottom_navigation_height
        default and reads as too thin. 64dp is what Figma 118:506 specifies -
        its content container sits at y=17 with height 47, so content ends at
        64. The rest of the board's 102dp bar is an iPhone home indicator,
        which on Android is the system gesture inset that
        applyBottomNavScreenInsets already pads for.

        itemMinHeight rather than a fixed layout_height: that inset is applied
        as padding INSIDE this view, so a fixed height would be eaten by it on
        a gesture-nav device. Growing the item also grows the touch target,
        which padding would not.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemIconSize="20dp"
        app:itemMinHeight="64dp"
        app:itemTextAppearanceActive="@style/WedoraNavLabel"
        app:itemTextAppearanceInactive="@style/WedoraNavLabel"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
