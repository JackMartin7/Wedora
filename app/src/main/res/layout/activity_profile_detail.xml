<?xml version="1.0" encoding="utf-8"?>
<!--
    Another user's profile. Opened from Home's feed cards, Explore, Likes,
    the Discover list, a chat thread's header, and match/like notifications.

    Shows what the backend has for other users: name, the age/city/country
    they supplied at Complete Profile, and their uploaded photo — loaded from
    photoUrl via loadRemoteProfilePhoto (see ProfileDetailActivity.bind).
    ic_avatar_placeholder is the android:src fallback for a user who hasn't
    uploaded one, not the normal case.

    (This header used to say there was no photo backend for other users and
    that the slot was always a placeholder. That stopped being true once
    PhotoUploadService started publishing a hosted photoUrl alongside the
    device-local copy — the local file is only for the owner's own device.)
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="40dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="@string/cd_more_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/actionRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
                ===== Photo header =====

                Full-bleed, with the name, location and distance overlaid on a
                scrim rather than stacked beneath the photo (Figma 132:2). The
                16dp side padding that used to sit on this column moved down to
                the section column below, so the image reaches the screen edges.

                ConstraintLayout, not a FrameLayout, for one reason that still
                applies: the photo needs a MAXIMUM WIDTH.

                Its height is fixed but its width is match_parent, so the
                frame's ASPECT RATIO tracks the screen's. Portrait gives roughly
                375x360 (near square) and centerCrop trims a little off a
                portrait photo; landscape would give roughly 720x360, and
                centerCrop would scale the same photo to ~960dp tall to fill
                that width, showing only the middle 360dp - about 60% of the
                image cropped away.

                constraintWidth_max caps it at 400dp, so landscape gets 400x360
                instead - near enough to the portrait shape that the crop
                matches. Below 400dp (every phone in portrait) the cap never
                applies. The spare width in landscape shows the screen
                background either side, reading as a centred photo rather than
                a stretched band.

                Note this is a WIDTH cap, not an aspect ratio: constraining the
                ratio instead would make a landscape frame ~960dp tall, which is
                worse than the bug. The overlay and scrim are constrained to the
                PHOTO rather than to this container, so at that cap they stay on
                the image instead of floating over the background beside it.
            -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="360dp">

                <!-- No shapeAppearanceOverlay any more: the photo is full-bleed,
                     so rounded corners would cut notches out of the screen
                     edges. -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDetailPhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_max="400dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_placeholder"
                    android:contentDescription="@string/cd_profile_photo" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_detail_scrim"
                    app:layout_constraintBottom_toBottomOf="@id/ivDetailPhoto"
                    app:layout_constraintStart_toStartOf="@id/ivDetailPhoto"
                    app:layout_constraintEnd_toEndOf="@id/ivDetailPhoto" />

                <!-- Moved to the TOP end of the photo. It used to sit bottom-end,
                     which is now where the distance line runs. -->
                <include
                    android:id="@+id/onlineDot"
                    layout="@layout/view_online_status_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="14dp"
                    app:layout_constraintEnd_toEndOf="@id/ivDetailPhoto"
                    app:layout_constraintTop_toTopOf="@id/ivDetailPhoto" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivDetailPhoto"
                    app:layout_constraintStart_toStartOf="@id/ivDetailPhoto"
                    app:layout_constraintEnd_toEndOf="@id/ivDetailPhoto">

                    <!-- "Denele Harold, 40" - name and age together now, so
                         formatAgeLocation is no longer used on this screen. -->
                    <TextView
                        android:id="@+id/tvDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/wedora_text_on_photo"
                        android:textSize="26sp"
                        android:fontFamily="@font/poppins_semibold"
                        tools:text="Denele Harold, 40" />

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_location_pin"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/wedora_caption_on_photo"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/wedora_caption_on_photo"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Washington DC, Queensland" />

                    <!-- PROVISIONAL ICON: ic_send is a paper plane and reads
                         close to the design's navigation arrow, but it is not
                         the exported asset. Replace when the real SVG lands. -->
                    <TextView
                        android:id="@+id/tvDetailDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_send"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/wedora_caption_on_photo"
                        android:maxLines="1"
                        android:textColor="@color/wedora_caption_on_photo"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="9775 km away" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===== Sections. Padded; the photo above deliberately is not. ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!--
                    Looking For / Status. One card with two labelled columns,
                    not two cards, and no section heading above it - it carries
                    its own inline labels (Figma 132:2).

                    Values are the RAW lookingFor / myStatus fields rather than
                    MarriageIntent.summaryLine's combined string: the column
                    labels already say which is which, so "Looking for Second
                    Wife" under a "LOOKING FOR" heading would stutter.

                    Each column hides independently, and the divider goes with
                    whichever survives. WIDTH RISK: the board shows "Any" and
                    "Single", but real values run to "Second Wife" and
                    "Divorced" - hence maxLines and ellipsize on both.
                -->
                <LinearLayout
                    android:id="@+id/cardIntent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_info_card"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_icon_button"
                        android:src="@drawable/ic_like_outline"
                        android:tint="@color/wedora_text_secondary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:id="@+id/colLookingFor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/WedoraCardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_looking_for" />

                        <TextView
                            android:id="@+id/tvDetailLookingFor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/wedora_text"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            tools:text="Any" />

                    </LinearLayout>

                    <View
                        android:id="@+id/intentDivider"
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/wedora_hairline" />

                    <LinearLayout
                        android:id="@+id/colStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            style="@style/WedoraCardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_status" />

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/wedora_text"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            tools:text="Single" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/WedoraSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_about" />

                    <TextView
                        android:id="@+id/tvDetailBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_about_card"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingVertical="14dp"
                        android:lineSpacingExtra="5sp"
                        android:textColor="@color/wedora_text_secondary"
                        android:textSize="14sp"
                        tools:text="Adventure seeker and coffee enthusiast." />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/WedoraSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_interests" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsDetailInterests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pass / Message / Like -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnPass"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="18dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_action_pass"
            app:tint="@color/wedora_text_secondary"
            android:contentDescription="@string/cd_pass" />

        <!-- Same icon/tint item_match_card.xml already uses for its own chat
             button; tap behaviour is unchanged (messageUser()) — this was
             previously a rectangular pill whose label toggled between "Like &
             Message" and "Message" depending on match state. An icon-only
             circular button can't carry that distinction, so the label is
             gone, but which action fires on tap is identical either way. -->
        <ImageButton
            android:id="@+id/btnMessage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:padding="16dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_nav_chats"
            app:tint="@color/wedora_accent"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/cd_message" />

        <!-- The heart colour lives in ic_like_filled / ic_like_outline (no
             app:tint), so the toggle only swaps src. Hidden until the like
             check resolves; likeLoading occupies its slot until then, so the
             heart never briefly shows the wrong state. -->
        <!--
            Mirrors the swipe card's like control: heart plus the received-like
            count, so the same affordance means the same thing on both screens.

            The wrapper, not btnLike, carries the visibility toggle now.
            applyLikeState hides this whole control until the like check
            resolves, with likeLoading occupying the slot meanwhile; toggling
            the button alone would leave the number sitting in an empty pill.

            bg_like_accent_pill rather than bg_icon_button: that one is an
            oval and would draw as an ellipse at this width. It is filled
            accent rather than a subtle surface because the design makes Like
            the one emphasised action of the three.
        -->
        <LinearLayout
            android:id="@+id/likeControl"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:background="@drawable/bg_like_accent_pill"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnLike"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:background="@null"
                android:src="@drawable/ic_like_outline"
                android:tint="@color/white"
                android:contentDescription="@string/cd_like" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="24dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                tools:text="42" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/likeLoading"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:padding="18dp"
            android:indeterminateTint="@color/wedora_accent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
