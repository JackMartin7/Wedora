<?xml version="1.0" encoding="utf-8"?>
<!--
    Another user's profile. Opened from Home's feed cards, Explore, Likes,
    the Discover list, a chat thread's header, and match/like notifications.

    Shows what the backend has for other users: name, the age/city/country
    they supplied at Complete Profile, and their uploaded photo — loaded from
    photoUrl via loadRemoteProfilePhoto (see ProfileDetailActivity.bind).
    ic_avatar_placeholder is the android:src fallback for a user who hasn't
    uploaded one, not the normal case.

    (This header used to say there was no photo backend for other users and
    that the slot was always a placeholder. That stopped being true once
    PhotoUploadService started publishing a hosted photoUrl alongside the
    device-local copy — the local file is only for the owner's own device.)
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wedora_bg">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="40dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="@string/cd_more_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/actionRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!--
                ConstraintLayout, not a FrameLayout, for one reason: the photo
                needs a maximum width.

                Its height is fixed but its width used to be match_parent, so
                the frame's ASPECT RATIO tracked the screen's. Portrait gave
                roughly 328x360 (near square) and centerCrop trimmed a little
                off a portrait photo; landscape gave roughly 720x360, and
                centerCrop had to scale the same photo to ~960dp tall to fill
                that width, showing only the middle 360dp — about 60% of the
                image cropped away.

                constraintWidth_max caps it at 400dp, so landscape gets
                400x360 instead of 720x360 — near enough to the portrait shape
                that the crop matches. Below 400dp (every phone in portrait)
                the cap never applies and nothing changes. The spare width in
                landscape shows the screen background either side, reading as
                a centred photo rather than a stretched band.

                Note this is a WIDTH cap, not an aspect ratio: constraining the
                ratio instead would make a landscape frame ~960dp tall, which
                is worse than the bug.
            -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="360dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDetailPhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_max="400dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:src="@drawable/ic_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/cd_profile_photo"
                    app:shapeAppearanceOverlay="@style/WedoraCardImage" />

                <!-- Larger (16dp) variant, and live rather than one-time: this
                     is the one screen where the viewer is looking at a single
                     person continuously, so it's worth a listener over a get().

                     Anchored to the PHOTO's corner, not the parent's: once the
                     width cap kicks in they are no longer the same edge, and
                     a parent-anchored dot would float in the empty margin
                     beside the photo in landscape. -->
                <include
                    android:id="@+id/onlineDot"
                    layout="@layout/view_online_status_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    app:layout_constraintEnd_toEndOf="@id/ivDetailPhoto"
                    app:layout_constraintBottom_toBottomOf="@id/ivDetailPhoto" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/wedora_text"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_semibold"
                tools:text="Amelia Hart" />

            <!-- Hidden when either this user or the profile has no
                 coordinates on file. Stays in the header block rather than
                 under Basics: it describes the VIEWER's relationship to this
                 person, not a fact about the person. -->
            <TextView
                android:id="@+id/tvDetailDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_distance_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="2.4 km" />

            <!--
                ===== Labelled sections =====

                Each section wraps its header WITH its content and is hidden
                as a unit. That is the load-bearing part: profiles here are
                often sparse, and a "BASICS" heading sitting above nothing
                reads as a rendering bug rather than as missing data.

                Always expanded, not collapsible. The bodies are a line or two
                each plus a handful of chips, so collapsing would save almost
                no height while adding state to restore across rotation and
                tap targets competing with the like/pass row below. The screen
                already scrolls.
            -->

            <LinearLayout
                android:id="@+id/sectionBasics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/WedoraSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_basics" />

                <!-- One combined line from formatAgeLocation rather than split
                     into rows: that helper already handles the awkward
                     combinations (age but no city, city but no country), and
                     re-deriving that here would regress quietly on sparse
                     profiles. -->
                <TextView
                    android:id="@+id/tvDetailAgeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/wedora_text"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="24 • Islamabad, Pakistan" />

                <TextView
                    android:id="@+id/tvDetailGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Female" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/WedoraSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_about" />

                <TextView
                    android:id="@+id/tvDetailBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4sp"
                    android:textColor="@color/wedora_text_secondary"
                    android:textSize="14sp"
                    tools:text="Coffee, long walks and terrible puns." />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionLookingFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/WedoraSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_looking_for" />

                <!-- One line from MarriageIntent.summaryLine, same reasoning
                     as the Basics line. Keeps its badge styling inside the
                     section rather than becoming plain text. -->
                <TextView
                    android:id="@+id/tvDetailIntent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_intent_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/wedora_tag_text"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    tools:text="Divorced • Looking for Second Wife" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionInterests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/WedoraSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_interests" />

                <!-- Filled by setInterestsReadOnly, which renders only this
                     profile's own interests and makes them inert. Interests
                     shared with the viewer sort first and take an accent
                     stroke. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsDetailInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/wedora_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pass / Message / Like -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnPass"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="18dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_action_pass"
            app:tint="@color/wedora_text_secondary"
            android:contentDescription="@string/cd_pass" />

        <!-- Same icon/tint item_match_card.xml already uses for its own chat
             button; tap behaviour is unchanged (messageUser()) — this was
             previously a rectangular pill whose label toggled between "Like &
             Message" and "Message" depending on match state. An icon-only
             circular button can't carry that distinction, so the label is
             gone, but which action fires on tap is identical either way. -->
        <ImageButton
            android:id="@+id/btnMessage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:padding="16dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_nav_chats"
            app:tint="@color/wedora_accent"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/cd_message" />

        <!-- The heart colour lives in ic_like_filled / ic_like_outline (no
             app:tint), so the toggle only swaps src. Hidden until the like
             check resolves; likeLoading occupies its slot until then, so the
             heart never briefly shows the wrong state. -->
        <!--
            Mirrors the swipe card's like control: heart plus the received-like
            count, so the same affordance means the same thing on both screens.

            The wrapper, not btnLike, carries the visibility toggle now.
            applyLikeState hides this whole control until the like check
            resolves, with likeLoading occupying the slot meanwhile; toggling
            the button alone would leave the number sitting in an empty pill.

            bg_like_count_pill rather than bg_icon_button: that one is an oval
            and would draw as an ellipse at this width.
        -->
        <LinearLayout
            android:id="@+id/likeControl"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:background="@drawable/bg_like_count_pill"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnLike"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:background="@null"
                android:src="@drawable/ic_like_outline"
                android:contentDescription="@string/cd_like" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="24dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/wedora_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                tools:text="42" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/likeLoading"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:padding="18dp"
            android:indeterminateTint="@color/wedora_accent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
