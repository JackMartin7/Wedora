<?xml version="1.0" encoding="utf-8"?>
<!--
    "Loading ad, please wait…" — covers the gap between tapping Watch Ad and
    the rewarded ad opening, which is a couple of seconds of nothing on a
    button that has already dismissed its sheet.

    Deliberately the same card-on-scrim treatment as
    layout_auth_loading_overlay.xml, which solves the identical problem for
    the Google sign-in chain. Not ProgressDialog — deprecated since API 26.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/wedora_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ad_loading_message"
            android:textColor="@color/wedora_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium" />

    </LinearLayout>

</FrameLayout>
