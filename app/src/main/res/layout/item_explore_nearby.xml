<?xml version="1.0" encoding="utf-8"?>
<!--
    One person in the Explore "People Nearby" strip.

    Redesigned to the "NEW FACES" treatment from Figma node 118:659 — a
    rounded SQUARE thumbnail with a hairline border, rather than the circular
    accent-ringed avatar it was. The design shows these as a 3-up grid with no
    labels; the strip keeps its horizontal scroll and its name/distance labels,
    since those carry information the grid version simply omits rather than
    replaces.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivNearbyAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_avatar"
        app:strokeColor="@color/wedora_hairline"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/WedoraCardImage" />

    <TextView
        android:id="@+id/tvNearbyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/wedora_text"
        android:textSize="12sp"
        tools:text="Amelia" />

    <!-- Accent distance pill; hidden when this pair has no computable distance. -->
    <TextView
        android:id="@+id/tvNearbyDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_v2_glass_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/wedora_caption"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="2.4 km" />

</LinearLayout>
