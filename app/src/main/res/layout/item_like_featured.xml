<?xml version="1.0" encoding="utf-8"?>
<!--
    A "featured" like tile: the same square photo as the grid, blurred, with a
    lock over it. Name and location are deliberately absent — the whole point
    is that the liker isn't identifiable until the user upgrades.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFeaturedPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_locked_like"
        app:shapeAppearanceOverlay="@style/WedoraCardImage"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:background="@drawable/bg_lock_circle"
        android:src="@drawable/ic_lock"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/ivFeaturedPhoto"
        app:layout_constraintBottom_toBottomOf="@id/ivFeaturedPhoto"
        app:layout_constraintStart_toStartOf="@id/ivFeaturedPhoto"
        app:layout_constraintEnd_toEndOf="@id/ivFeaturedPhoto" />

</androidx.constraintlayout.widget.ConstraintLayout>
