<?xml version="1.0" encoding="utf-8"?>
<!--
    One tile in the Likes grid: a square photo with the liker's name and
    location overlaid at the bottom over a darkening scrim.

    The photo drives the tile's height via a 1:1 ratio, so both columns stay
    square regardless of the grid's column width.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="?attr/selectableItemBackground">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivLikePhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_profile_photo"
        app:shapeAppearanceOverlay="@style/WedoraCardImage"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top-end corner rather than bottom-end (the usual avatar position):
         bottom-end here would sit inside the name/location caption below. -->
    <include
        android:id="@+id/onlineDot"
        layout="@layout/view_online_status_dot"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/ivLikePhoto"
        app:layout_constraintEnd_toEndOf="@id/ivLikePhoto" />

    <!-- Scrim anchored to the photo's lower portion for name legibility. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_photo_scrim"
        app:layout_constraintStart_toStartOf="@id/ivLikePhoto"
        app:layout_constraintEnd_toEndOf="@id/ivLikePhoto"
        app:layout_constraintBottom_toBottomOf="@id/ivLikePhoto"
        app:layout_constraintTop_toTopOf="@id/ivLikePhoto"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintHeight_percent="0.45" />

    <TextView
        android:id="@+id/tvLikeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toStartOf="@id/ivLikePhoto"
        app:layout_constraintEnd_toEndOf="@id/ivLikePhoto"
        app:layout_constraintBottom_toTopOf="@id/tvLikeLocation"
        tools:text="Amelia Hart" />

    <TextView
        android:id="@+id/tvLikeLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/ivLikePhoto"
        app:layout_constraintEnd_toEndOf="@id/ivLikePhoto"
        app:layout_constraintBottom_toBottomOf="@id/ivLikePhoto"
        tools:text="Islamabad, Pakistan" />

</androidx.constraintlayout.widget.ConstraintLayout>
