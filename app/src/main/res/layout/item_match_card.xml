<?xml version="1.0" encoding="utf-8"?>
<!--
    A single match card, redesigned from Figma node 118:447.

    STRUCTURAL CHANGE, not a restyle. The previous card was a vertical stack —
    mini profile row, then photo, then action row, then bio — where the photo
    was the one weighted child and took whatever height the fixed rows left
    over. This version inverts that: the PHOTO FILLS THE WHOLE CARD and
    everything else overlays it on scrims.

    Two things follow from that, both deliberate:

    1. The photo no longer competes with the text rows for height, which is
       what made it collapse to a thin band whenever the card was short (the
       landscape defect that forced HomeActivity into a portrait lock). This
       layout has no leftover-space calculation left to lose.

    2. Text now sits on an arbitrary photo rather than on a themed surface, so
       the two scrims below are load-bearing for legibility, not decoration.

    Every id from the previous version is preserved — MatchCard's binding and
    HomeActivity.bindCard reference all of them, and none of that code changed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_v2_card"
    android:foreground="?attr/selectableItemBackground">

    <!-- Fills the card and carries the 40dp radius itself: the parent's
         background is completely hidden behind it, so the corners have to be
         cut here or they render square. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCardPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_profile_photo"
        app:shapeAppearanceOverlay="@style/WedoraCardImageV2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_v2_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_v2_scrim_bottom" />

    <!-- ===== Header overlay: avatar, name/role, dismiss + more ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="20dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCardAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_avatar"
            app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

        <include
            android:id="@+id/onlineDot"
            layout="@layout/view_online_status_dot"
            android:layout_alignEnd="@id/ivCardAvatar"
            android:layout_alignBottom="@id/ivCardAvatar" />

        <!-- btnMore is outermost so btnDismiss can anchor to its start. -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="7dp"
            android:background="@drawable/bg_v2_glass_circle"
            android:src="@drawable/ic_menu_dots"
            android:tint="@color/wedora_v2_text"
            android:contentDescription="@string/cd_more" />

        <ImageButton
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btnMore"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:background="@drawable/bg_v2_glass_circle"
            android:src="@drawable/ic_close"
            android:tint="@color/wedora_v2_text"
            android:contentDescription="@string/cd_dismiss" />

        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivCardAvatar"
            android:layout_toStartOf="@id/btnDismiss"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_alignTop="@id/ivCardAvatar"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wedora_v2_text"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            tools:text="Jane Nyambura" />

        <TextView
            android:id="@+id/tvCardRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardName"
            android:layout_alignStart="@id/tvCardName"
            android:layout_toStartOf="@id/btnDismiss"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wedora_v2_caption"
            android:textSize="12sp"
            tools:text="Photographer" />

    </RelativeLayout>

    <!-- Swipe feedback, above the scrims so it reads during a drag. Alpha is
         driven by SwipeCardStackView. -->
    <ImageView
        android:id="@+id/overlayLike"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_like_filled"
        android:tint="@color/wedora_v2_accent"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/overlayPass"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_action_pass"
        android:tint="@color/wedora_v2_text"
        android:contentDescription="@null" />

    <!-- ===== Bottom overlay: actions, bio, status ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 56dp glass squares, per the design. The design also shows a
                 like COUNT beside the heart; omitted rather than faked —
                 nothing in this app tracks per-profile like counts. -->
            <ImageButton
                android:id="@+id/btnLike"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:background="@drawable/bg_v2_glass_pill"
                android:src="@drawable/ic_like_outline"
                android:tint="@color/wedora_v2_accent"
                android:contentDescription="@string/cd_like" />

            <ImageButton
                android:id="@+id/btnPass"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:padding="16dp"
                android:background="@drawable/bg_v2_glass_pill"
                android:src="@drawable/ic_action_pass"
                android:tint="@color/wedora_v2_text"
                android:contentDescription="@string/cd_pass" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:padding="16dp"
                android:background="@drawable/bg_v2_glass_pill"
                android:src="@drawable/ic_nav_chats"
                android:tint="@color/wedora_v2_text"
                android:contentDescription="@string/cd_message" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Keeps its id and its "2.4 km" content; the design renders it
                 as a glass chip rather than the solid accent pill it was. -->
            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v2_glass_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:drawableStart="@drawable/ic_location_pin"
                android:drawablePadding="6dp"
                android:drawableTint="@color/wedora_v2_accent_soft"
                android:maxLines="1"
                android:textColor="@color/wedora_v2_caption"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="2.4 km" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCardBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/wedora_v2_text"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_medium"
            tools:text="24 • Islamabad, Pakistan" />

        <TextView
            android:id="@+id/tvCardBioPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/wedora_v2_caption"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Coffee, long walks and terrible puns." />

        <TextView
            android:id="@+id/tvCardIntent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_v2_status_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="@color/wedora_v2_pill_text"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Divorced • Looking for Second Wife" />

    </LinearLayout>

</FrameLayout>
