<?xml version="1.0" encoding="utf-8"?>
<!--
    A single match card:
      mini profile row  ->  full-width photo (~330dp)  ->  action row  ->  bio
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="20dp"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground">

    <!-- ===== Mini profile row ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCardAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_avatar"
            app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_dots"
            android:contentDescription="@string/cd_more" />

        <ImageButton
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btnMore"
            android:layout_centerVertical="true"
            android:padding="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/cd_dismiss" />

        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivCardAvatar"
            android:layout_toStartOf="@id/btnDismiss"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/wedora_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:id="@+id/tvCardRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardName"
            android:layout_alignStart="@id/tvCardName"
            android:layout_toStartOf="@id/btnDismiss"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="12sp" />

    </RelativeLayout>

    <!-- ===== Photo + swipe stamps ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="330dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCardPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/WedoraCardImage" />

        <!-- Alpha driven by SwipeCardStackView during a drag. LIKE top-start
             on a right swipe, PASS top-end on a left swipe. -->
        <TextView
            android:id="@+id/overlayLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_label_like"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:rotation="-18"
            android:text="@string/swipe_label_like"
            android:textColor="@color/wedora_success"
            android:textSize="26sp"
            android:fontFamily="@font/poppins_semibold"
            android:alpha="0" />

        <TextView
            android:id="@+id/overlayPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_label_pass"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:rotation="18"
            android:text="@string/swipe_label_pass"
            android:textColor="@color/wedora_error"
            android:textSize="26sp"
            android:fontFamily="@font/poppins_semibold"
            android:alpha="0" />

    </FrameLayout>

    <!-- ===== Action row ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <!-- No app:tint here on purpose: the liked/unliked colour lives in the
             two drawables, so binding only has to swap src. -->
        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_like_outline"
            android:contentDescription="@string/cd_like" />

        <ImageButton
            android:id="@+id/btnPass"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:padding="10dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_action_pass"
            app:tint="@color/wedora_text_secondary"
            android:contentDescription="@string/cd_pass" />

        <!-- Opens the conversation, matching first if there isn't one yet. -->
        <ImageButton
            android:id="@+id/btnChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_nav_chats"
            app:tint="@color/wedora_accent"
            android:contentDescription="@string/cd_message" />

        <!-- pushes the distance pill to the end -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_distance_pill"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" />

    </LinearLayout>

    <!-- ===== Bio ===== -->
    <TextView
        android:id="@+id/tvCardBio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4sp"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="13sp" />

    <!-- Truncated bio, below the age/location line. Hidden when this user
         hasn't written one. -->
    <TextView
        android:id="@+id/tvCardBioPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Coffee, long walks and terrible puns." />

</LinearLayout>
