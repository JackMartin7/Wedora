<?xml version="1.0" encoding="utf-8"?>
<!--
    A single match card, redesigned from Figma node 118:447.

    STRUCTURAL CHANGE, not a restyle. The previous card was a vertical stack —
    mini profile row, then photo, then action row, then bio — where the photo
    was the one weighted child and took whatever height the fixed rows left
    over. This version inverts that: the PHOTO FILLS THE WHOLE CARD and
    everything else overlays it on scrims.

    Two things follow from that, both deliberate:

    1. The photo no longer competes with the text rows for height, which is
       what made it collapse to a thin band whenever the card was short (the
       landscape defect that forced HomeActivity into a portrait lock). This
       layout has no leftover-space calculation left to lose.

    2. Text now sits on an arbitrary photo rather than on a themed surface, so
       the two scrims below are load-bearing for legibility, not decoration.

    Every id from the previous version is preserved — MatchCard's binding and
    HomeActivity.bindCard reference all of them, and none of that code changed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_v2_card"
    android:foreground="?attr/selectableItemBackground">

    <!-- Fills the card and carries the 40dp radius itself: the parent's
         background is completely hidden behind it, so the corners have to be
         cut here or they render square. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCardPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_profile_photo"
        app:shapeAppearanceOverlay="@style/WedoraCardImageV2" />

    <!-- 88dp: the exact height of the design's "User Header on Card"
         container (Figma 118:492, 341x88), which is what carries this
         gradient there. It was 140dp, which darkened 52dp more of the photo
         than designed. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_v2_scrim_top" />

    <!-- Full card height, not a fixed band: the spec's gradient is size-full
         with its ramp expressed as a percentage (transparent to 60%, then to
         0.8 black). A fixed 320dp band cannot scale that ramp with the card,
         and on a tall card left the top of the band as a visible hard edge. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_v2_scrim_bottom" />

    <!-- ===== Header overlay: avatar, name/role, dismiss + more ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="20dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCardAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_avatar"
            app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

        <include
            android:id="@+id/onlineDot"
            layout="@layout/view_online_status_dot"
            android:layout_alignEnd="@id/ivCardAvatar"
            android:layout_alignBottom="@id/ivCardAvatar" />

        <!-- btnMore is outermost so btnDismiss can anchor to its start. -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="7dp"
            android:background="@drawable/bg_v2_glass_circle"
            android:src="@drawable/ic_menu_dots"
            android:tint="@color/wedora_text_on_photo"
            android:contentDescription="@string/cd_more" />

        <ImageButton
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btnMore"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:background="@drawable/bg_v2_glass_circle"
            android:src="@drawable/ic_close"
            android:tint="@color/wedora_text_on_photo"
            android:contentDescription="@string/cd_dismiss" />

        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivCardAvatar"
            android:layout_toStartOf="@id/btnDismiss"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_alignTop="@id/ivCardAvatar"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wedora_text_on_photo"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            tools:text="Jane Nyambura" />

        <TextView
            android:id="@+id/tvCardRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardName"
            android:layout_alignStart="@id/tvCardName"
            android:layout_toStartOf="@id/btnDismiss"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wedora_caption_on_photo"
            android:textSize="12sp"
            tools:text="Photographer" />

    </RelativeLayout>

    <!-- Swipe feedback, above the scrims so it reads during a drag. Alpha is
         driven by SwipeCardStackView. -->
    <ImageView
        android:id="@+id/overlayLike"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_like_filled"
        android:tint="@color/wedora_accent_on_photo"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/overlayPass"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_action_pass"
        android:tint="@color/wedora_text_on_photo"
        android:contentDescription="@null" />

    <!-- ===== Bottom overlay: actions, bio, status ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--
                56dp glass squares for pass and chat; the like control is a
                wider pill carrying the received-like count, which is what
                Figma 118:454 specifies (93.66x58, a 24x24 heart at 118:456
                plus a 27.66x20 text leaf at 118:458, against 56x56 for the
                other two). The count was omitted when this card was first
                built because nothing tracked it - the onMatchWritten Cloud
                Function now does.

                The background moved from the button onto this wrapper so the
                heart and the number share one pill. btnLike keeps its id and
                stays an ImageButton: HomeActivity calls setImageResource on
                it and unlikeInPlace takes an ImageButton, so changing its
                type would break the heart toggle.

                48dp rather than the design's 41dp icon box: 48dp is the
                minimum touch target, and it puts the pill at roughly 96dp
                against the design's 93.66dp - closer than shrinking the tap
                area would be worth.
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_v2_glass_pill_on_photo">

                <ImageButton
                    android:id="@+id/btnLike"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@null"
                    android:src="@drawable/ic_like_outline"
                    android:tint="@color/wedora_accent_on_photo"
                    android:contentDescription="@string/cd_like" />

                <!-- A bare number, not "24 likes": the design's text leaf is
                     27.66dp wide, which fits a figure and no word. minWidth
                     stops the pill resizing as the deck advances between one
                     and two digit counts. -->
                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="24dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/wedora_text_on_photo"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold"
                    tools:text="42" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPass"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:padding="16dp"
                android:background="@drawable/bg_v2_glass_pill_on_photo"
                android:src="@drawable/ic_action_pass"
                android:tint="@color/wedora_text_on_photo"
                android:contentDescription="@string/cd_pass" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:padding="16dp"
                android:background="@drawable/bg_v2_glass_pill_on_photo"
                android:src="@drawable/ic_nav_chats"
                android:tint="@color/wedora_text_on_photo"
                android:contentDescription="@string/cd_message" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--
                Distance, as a narrow VERTICAL block: pin above the number
                above the unit. Figma 118:468 specifies exactly this shape
                (63.88 wide, with a 9x14 pin at 118:469 and the number and
                unit as separate stacked text leaves at 118:471/118:472).

                It was previously built as a horizontal chip, which is about
                44dp wider, and that is what overflowed the row - four items
                needed ~344dp against 332dp available on a 412dp screen, so
                the label was cropped mid-word. The design's vertical stack
                is precisely what makes four items fit.

                Shortened deliberately: the design's block is 90dp tall,
                which would push the bio down by 34dp. This one wraps its
                content instead and lands near 64dp.

                BOUNDED WIDTH is the safety net. tvDistance's maxWidth caps
                the number, so the whole block cannot exceed roughly 68dp no
                matter what value arrives - a wildly wrong coordinate can no
                longer widen the row until something clips. Below ~360dp the
                row is still tight, but it degrades by ellipsizing the number
                rather than hard-cropping the pill.

                tvDistance keeps its id and stays the number only; the unit
                moved to its own view, so bindCard splits the formatted
                string. DistanceUtils.formatDistance is untouched, since the
                other three screens still want it whole.
            -->
            <LinearLayout
                android:id="@+id/distanceBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_v2_glass_pill_on_photo"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location_pin"
                    android:tint="@color/wedora_accent_soft_on_photo"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxWidth="48dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/wedora_text_on_photo"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    tools:text="2.4" />

                <TextView
                    android:id="@+id/tvDistanceUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/wedora_caption_on_photo"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_medium"
                    tools:text="km" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCardBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/wedora_text_on_photo"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_medium"
            tools:text="24 • Islamabad, Pakistan" />

        <TextView
            android:id="@+id/tvCardBioPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/wedora_caption_on_photo"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Coffee, long walks and terrible puns." />

        <TextView
            android:id="@+id/tvCardIntent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_v2_status_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="@color/wedora_accent_soft_on_photo"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Divorced • Looking for Second Wife" />

    </LinearLayout>

</FrameLayout>
