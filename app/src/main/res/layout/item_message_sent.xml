<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing message: right-aligned, accent bubble, white text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_bubble_sent"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="2sp"
        tools:text="Hey! How's your week going?" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wedora_text_secondary"
            android:textSize="11sp"
            tools:text="9:41 AM" />

        <!-- Read-receipt checkmark; tinted grey/blue in MessageAdapter -->
        <ImageView
            android:id="@+id/ivMessageStatus"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_double"
            tools:tint="@color/wedora_read_receipt" />

    </LinearLayout>

    <!-- Reaction pills, e.g. "❤️ 2" — GONE when nobody's reacted. Built up in
         MessageAdapter, one bg_card-styled pill per distinct emoji. -->
    <LinearLayout
        android:id="@+id/reactionsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:contentDescription="@string/cd_message_reactions" />

</LinearLayout>
