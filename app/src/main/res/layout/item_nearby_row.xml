<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the full People Nearby list: circular avatar, name over
    age/location, and the distance on the right in an accent pill.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivNearbyAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@string/cd_avatar"
        app:strokeColor="@color/wedora_accent"
        app:strokeWidth="2dp"
        app:shapeAppearanceOverlay="@style/WedoraCircleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvNearbyName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/wedora_text"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/ivNearbyAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvNearbyDistance"
        app:layout_constraintTop_toTopOf="@id/ivNearbyAvatar"
        app:layout_constraintBottom_toTopOf="@id/tvNearbyMeta"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Amelia Hart" />

    <TextView
        android:id="@+id/tvNearbyMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/ivNearbyAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvNearbyDistance"
        app:layout_constraintTop_toBottomOf="@id/tvNearbyName"
        app:layout_constraintBottom_toBottomOf="@id/ivNearbyAvatar"
        tools:text="24 • Islamabad, Pakistan" />

    <TextView
        android:id="@+id/tvNearbyDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_distance_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="2.4 km" />

</androidx.constraintlayout.widget.ConstraintLayout>
