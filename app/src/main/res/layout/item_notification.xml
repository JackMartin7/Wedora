<?xml version="1.0" encoding="utf-8"?>
<!--
    One notification row: avatar, "<name> liked your profile", and a relative
    timestamp on the right.

    Name and action text form a packed horizontal chain so they read as one
    sentence, bounded by the timestamp on the right.

    The name carries layout_constrainedWidth, which is what actually makes it
    ellipsize. A wrap_content view in a chain is measured at its full desired
    width and ConstraintLayout will not compress it, so a long name kept its
    whole length and ran under the timestamp — ellipsize never fired because
    the view was never denied the space it asked for.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivNotificationAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_avatar"
        app:shapeAppearanceOverlay="@style/WedoraCircleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvNotificationName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wedora_text"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@id/ivNotificationAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvNotificationAction"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Amelia Hart" />

    <TextView
        android:id="@+id/tvNotificationAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/notification_liked_your_profile"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/tvNotificationName"
        app:layout_constraintEnd_toStartOf="@id/tvNotificationTime"
        app:layout_constraintTop_toTopOf="@id/tvNotificationName"
        app:layout_constraintBottom_toBottomOf="@id/tvNotificationName" />

    <!--
        Deliberately not part of the chain: only its end is anchored, so it
        always measures at full width and the name gives way instead. The 8dp
        gap is the action's end margin, so the timestamp sits flush with the
        row's own 20dp horizontal padding and lines up with the avatar.
    -->
    <TextView
        android:id="@+id/tvNotificationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="2m ago" />

</androidx.constraintlayout.widget.ConstraintLayout>
