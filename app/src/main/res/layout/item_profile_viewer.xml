<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in "Who Viewed My Profile": avatar (with online dot) + name +
    "Viewed X ago" on the right — same shape as item_notification.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivViewerAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_avatar"
        app:shapeAppearanceOverlay="@style/WedoraCircleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/onlineDot"
        layout="@layout/view_online_status_dot"
        app:layout_constraintEnd_toEndOf="@id/ivViewerAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivViewerAvatar" />

    <TextView
        android:id="@+id/tvViewerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/wedora_text"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/ivViewerAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvViewerTime"
        app:layout_constraintTop_toTopOf="@id/ivViewerAvatar"
        tools:text="Amelia Hart" />

    <TextView
        android:id="@+id/tvViewerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivViewerAvatar"
        tools:text="Viewed 2h ago" />

    <!-- Below the name; hidden when there's no distance, which leaves the
         row exactly as tall as it was before. -->
    <TextView
        android:id="@+id/tvViewerDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_distance_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="2.4 km"
        app:layout_constraintStart_toEndOf="@id/ivViewerAvatar"
        app:layout_constraintTop_toBottomOf="@id/tvViewerName" />

</androidx.constraintlayout.widget.ConstraintLayout>
