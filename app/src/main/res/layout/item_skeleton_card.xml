<?xml version="1.0" encoding="utf-8"?>
<!--
    Swipe-stack loading placeholder, mirroring item_match_card as it stands.

    REWRITTEN, not restyled. It used to be a padded card holding a small avatar
    row, a fixed 220dp photo block and a bio bar - which was an accurate mirror
    of the card back when that card was a vertical stack. The card has since
    been inverted: the photo fills it and everything else overlays the photo on
    scrims. The old skeleton therefore crossfaded from a small photo inside a
    padded box into a full-bleed photo card, which read as the layout changing
    at load rather than as content arriving.

    So this is a FrameLayout with one full-bleed placeholder underneath and the
    overlay shapes on top, matching where the real content lands:

      top-left      40dp avatar circle, name bar, role bar
      bottom-left   the action row - a wide like pill, two square buttons, and
                    the narrow distance block - then the bio lines

    Heights come from the container rather than fixed values, so this occupies
    the same box cardStack does (see skeletonFeed in activity_home.xml, now 0dp
    with the same bottom constraint). A fixed-height placeholder made the
    crossfade jump.

    Only ONE of these is inflated now (HomeActivity.SKELETON_CARDS). Three made
    sense when each was a short wrap_content card; a full-height one cannot
    repeat down a vertical LinearLayout, and the real stack overlaps its cards
    rather than stacking them anyway.

    The shimmer is driven from the container by Skeletons.kt, not from here -
    nothing in this file animates.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_v2_card">

    <!-- The photo. Fills the card and carries its radius, exactly as
         ivCardPhoto does on the real card. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_skeleton_card_v2" />

    <!-- ===== Header overlay: avatar, name, role ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <View
                android:layout_width="132dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="84dp"
                android:layout_height="11dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== Bottom overlay: action row, bio ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <!-- Mirrors the real action row's widths: the like control is a wide
             pill carrying a count, pass and chat are 56dp squares, and the
             distance block is the narrow vertical one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_skeleton_card" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_skeleton_card" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_skeleton_card" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:layout_width="52dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_skeleton_card" />

        </LinearLayout>

        <View
            android:layout_width="180dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="220dp"
            android:layout_height="13dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton"
            tools:ignore="UnusedAttribute" />

    </LinearLayout>

</FrameLayout>
