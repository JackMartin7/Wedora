<?xml version="1.0" encoding="utf-8"?>
<!--
    Searchable country list, shared by the two capture fields (profile setup,
    Edit Profile) and by the Filters screen.

    Fixed height rather than wrap_content: the list is ~250 rows, so a
    wrap_content sheet would open at full screen every time. 60% of the screen
    keeps the search field reachable one-handed while showing enough rows to
    scroll meaningfully.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/wedora_border" />

    <TextView
        android:id="@+id/tvCountryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/country_picker_title"
        android:textColor="@color/wedora_text"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold" />

    <EditText
        android:id="@+id/etCountrySearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search_field"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:hint="@string/country_picker_search_hint"
        android:textColorHint="@color/wedora_text_secondary"
        android:textColor="@color/wedora_text"
        android:textSize="14sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/tvCountryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/country_picker_no_results"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Fixed height, not 0dp+weight: this LinearLayout is wrap_content inside
         a bottom sheet, so a weighted child has no remaining space to claim and
         would collapse to nothing. 420dp shows roughly eight rows and leaves
         the search field within thumb reach. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCountries"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        tools:listitem="@layout/item_country_row" />

</LinearLayout>
