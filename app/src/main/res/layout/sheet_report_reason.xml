<?xml version="1.0" encoding="utf-8"?>
<!-- Second step of a report: pick a reason, then submit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/wedora_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_reason_title"
        android:textColor="@color/wedora_text"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:singleLine="false"
        app:singleSelection="true"
        app:chipSpacingHorizontal="8dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitReport"
        style="@style/WedoraPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="@string/report_submit"
        tools:enabled="false" />

</LinearLayout>
