<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared empty state: illustration, bold title, grey subtitle, optional CTA.

    One layout for every screen so they can't drift apart in spacing or type
    scale. The icon, copy and button are set by EmptyState.kt; the button is
    GONE unless an action is supplied.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="40dp">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.5"
        android:contentDescription="@null"
        tools:src="@drawable/ic_sparkle_heart" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/wedora_text"
        android:textSize="17sp"
        android:fontFamily="@font/poppins_semibold"
        tools:text="No more profiles nearby" />

    <TextView
        android:id="@+id/tvEmptySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4sp"
        android:textColor="@color/wedora_text_secondary"
        android:textSize="14sp"
        tools:text="Check back later or adjust your filters" />

    <TextView
        android:id="@+id/btnEmptyAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_outline"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="@color/wedora_accent"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Adjust Filters" />

</LinearLayout>
