<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding slide 1 — avatar collage.

    Absolute composition on a fixed 280x280dp canvas; every child's
    layout_margin{Start,Top} is its x/y from the spec. FrameLayout is used
    deliberately: ob1_a4 (x=-6) and the heart badge (y=-14) sit outside the
    canvas, and FrameLayout honours negative margins where ConstraintLayout
    clamps them. clipChildren/clipToPadding are disabled all the way up the
    hierarchy so those overflows are not cut off.

    Each avatar's ring comes from bg_avatar_ring showing through padding:
    padding = (outer size - inner image size) / 2.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="280dp"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===== Background rings (concentric, centered) ===== -->

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_ring_outer" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_ring_mid" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_ring_inner" />

    <!-- ===== Surrounding avatars ===== -->

    <!-- top-left : 58x58 @ (0,18), inner 52 -->
    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="18dp"
        android:padding="3dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_2"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- top-right : 62x62 @ (186,20), inner 56 -->
    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginStart="186dp"
        android:layout_marginTop="20dp"
        android:padding="3dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_3"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- right-mid : 62x62 @ (232,105), inner 56 — overflows right edge ~14dp -->
    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginStart="232dp"
        android:layout_marginTop="105dp"
        android:padding="3dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_4"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- bottom-left : 62x62 @ (-6,198), inner 56 — overflows left edge ~6dp -->
    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="198dp"
        android:padding="3dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_6"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- bottom-center : 44x44 @ (80,201), inner 38 -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="201dp"
        android:padding="3dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_7"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ===== Hero (dead-center: (280-118)/2 = 81) ===== -->

    <ImageView
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_marginStart="81dp"
        android:layout_marginTop="81dp"
        android:padding="4dp"
        android:background="@drawable/bg_avatar_ring"
        android:src="@drawable/ic_avatar_1"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ===== Decorations (topmost, drawn last) ===== -->

    <!-- heart badge : 32x32 @ (124,-14) — floats above the top edge -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="-14dp"
        android:src="@drawable/ic_badge_heart"
        android:contentDescription="@null" />

    <!-- dot_1 : 36x36 @ (8,120) -->
    <View
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_deco_dot" />

    <!-- dot_2 : 34x34 @ (202,244) -->
    <View
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="202dp"
        android:layout_marginTop="244dp"
        android:background="@drawable/bg_deco_dot" />

</FrameLayout>
