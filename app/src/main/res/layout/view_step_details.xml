<?xml version="1.0" encoding="utf-8"?>
<!--
    Age plus location. Location has two mutually exclusive modes, toggled by
    the step depending on whether coarse location was granted and resolved:
      groupDetectedLocation -> read-only detected text + Refresh
      groupManualLocation   -> editable City / Country
    Every failure path lands on manual entry, so there is no way to get stuck.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/WedoraFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_age" />

    <EditText
        android:id="@+id/etAge"
        style="@style/WedoraInputField"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="@string/hint_age"
        android:inputType="number"
        android:maxLength="3"
        android:imeOptions="actionDone"
        android:autofillHints="" />

    <TextView
        style="@style/WedoraFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_location" />

    <!-- Mode A: detected -->
    <LinearLayout
        android:id="@+id/groupDetectedLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDetectedLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/location_detecting"
            android:textColor="@color/wedora_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRefreshLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/location_refresh"
            android:textColor="@color/wedora_accent"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium" />

    </LinearLayout>

    <!-- Mode B: manual -->
    <LinearLayout
        android:id="@+id/groupManualLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCity"
            style="@style/WedoraInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_city"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"
            android:autofillHints="postalAddressLocality" />

        <EditText
            android:id="@+id/etCountry"
            style="@style/WedoraInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_country"
            android:inputType="textCapWords"
            android:imeOptions="actionDone"
            android:autofillHints="postalAddressCountry" />

    </LinearLayout>

</LinearLayout>
