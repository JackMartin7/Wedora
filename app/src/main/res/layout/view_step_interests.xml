<?xml version="1.0" encoding="utf-8"?>
<!-- Step 7's content: just the chip picker — the scaffold's own title/
     subtitle already explain the step, and unlike Status/Looking For there's
     no gender-dependent option list to label separately. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsInterests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp" />

</FrameLayout>
