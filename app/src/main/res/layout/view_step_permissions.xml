<?xml version="1.0" encoding="utf-8"?>
<!--
    Content for the permissions primer step: two identically-shaped cards
    (icon, title + benefit line, Enable pill / granted checkmark). Two fixed
    cards rather than a RecyclerView — there are only ever these two, and
    they'll never be data-driven.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ===== Location card ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_pink_square"
            android:src="@drawable/ic_location_pin"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_location_title"
                android:textColor="@color/wedora_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2sp"
                android:text="@string/permissions_location_desc"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnEnableLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/permissions_enable_action"
            android:textColor="@color/wedora_accent"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" />

        <ImageView
            android:id="@+id/ivLocationGranted"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_verified_check"
            android:contentDescription="@string/cd_permission_granted"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- ===== Notifications card ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_pink_square"
            android:src="@drawable/ic_notification_bell"
            android:tint="@color/wedora_accent"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_notifications_title"
                android:textColor="@color/wedora_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2sp"
                android:text="@string/permissions_notifications_desc"
                android:textColor="@color/wedora_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnEnableNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/permissions_enable_action"
            android:textColor="@color/wedora_accent"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" />

        <ImageView
            android:id="@+id/ivNotificationsGranted"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_verified_check"
            android:contentDescription="@string/cd_permission_granted"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
