<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivStepPhoto"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@color/wedora_input_bg"
        android:padding="56dp"
        android:src="@drawable/ic_add_photo"
        android:scaleType="centerCrop"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_add_photo"
        app:shapeAppearanceOverlay="@style/WedoraCircleImage" />

    <TextView
        android:id="@+id/tvStepPhotoAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:text="@string/add_photo"
        android:textColor="@color/wedora_accent"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_medium" />

</LinearLayout>
