<?xml version="1.0" encoding="utf-8"?>
<!--
    Wedora design tokens — DARK mode.
    Names mirror values/colors.xml exactly; only the values differ.
    Brand colours are intentionally identical across both modes.
-->
<resources>
    <!-- Brand — identical in light and dark -->
    <color name="wedora_accent">#FA4659</color>
    <color name="wedora_gradient_start">#FF93A8</color>
    <color name="wedora_gradient_end">#FE4667</color>
    <color name="wedora_success">#3FB56E</color>
    <color name="wedora_error">#E23B4E</color>
    <color name="wedora_accent_shadow">#4DFA4659</color>
    <color name="wedora_premium_gold">#E5A93B</color>
    <!-- Was left at the light-mode value (#FFDADE) — a bug, not a deliberate
         "fixed both modes" choice like wedora_warning_bg: wedora_text on an
         unchanged light pink measured ~1.12:1 in dark mode, effectively
         invisible. This muted deep maroon-pink keeps the same card
         identity while giving wedora_text ~14.15:1 and wedora_accent (the
         inline "Sign Up" span) ~4.70:1 — both clear WCAG AA passes — and
         stays clearly distinct from wedora_bg (#1C1417, luminance ~0.008)
         at roughly 1.8x its luminance (~0.0148), not just a fainter shade
         of the same near-black. -->
    <color name="wedora_guest_cta_bg">#2E1B22</color>

    <!-- Surfaces -->
    <color name="wedora_bg">#1C1417</color>
    <color name="wedora_surface">#2A2124</color>
    <color name="wedora_border">#3A2E32</color>

    <!-- Text -->
    <color name="wedora_text">#F5EEEF</color>
    <color name="wedora_text_secondary">#B8ABAE</color>

    <!-- Skeleton loading placeholders -->
    <color name="wedora_skeleton">#2E2529</color>

    <!-- Inputs -->
    <color name="wedora_input_bg">#241A1D</color>
    <color name="wedora_input_border">#3A2E32</color>

    <!-- Decorative concentric rings behind the onboarding avatar collage -->
    <color name="wedora_ring_mid">#241A1D</color>
    <color name="wedora_ring_inner">#2E2226</color>

    <!-- Match screen radar background gradient — fixed brand colours, same both modes -->
    <color name="wedora_match_gradient_start">#FFE9EB</color>
    <color name="wedora_match_gradient_mid">#FE798A</color>

    <!-- Base -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
