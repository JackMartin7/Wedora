<?xml version="1.0" encoding="utf-8"?>
<!--
    Wedora design tokens — DARK mode.
    Names mirror values/colors.xml exactly; only the values differ.
    Most brand colours are intentionally identical across both modes — but
    NOT wedora_accent/wedora_accent_pressed/their derived shadow+tint
    tokens, deliberately brighter here than in light mode (see
    wedora_accent's own comment below).
-->
<resources>
    <!-- Brand — REBRAND: wedora_accent is now deliberately brighter here
         than in light mode (#F0748A vs #E22A48), unlike every other token
         on this page, so it doesn't look muddy against this near-black
         page. That in turn breaks the usual white-on-accent button-text
         pairing: white text on #F0748A measures only 2.77:1 (needs 4.5:1),
         and mechanically darkening the fill to fix it would undo the exact
         "brighter, not muddy" reasoning this value exists for. Instead
         wedora_text_on_primary flips to a dark color here — #1A1013 (this
         file's own wedora_bg) on #F0748A measures 6.71:1, and the same dark
         text on wedora_accent_pressed's ORIGINAL, unadjusted spec value
         (#D85A72) still clears AA at 4.99:1, so accent_pressed needed no
         hex change at all here, only the light-mode file's did. -->
    <color name="wedora_accent">#F0748A</color>
    <color name="wedora_accent_pressed">#D85A72</color>
    <!-- The dark-mode flip described above. -->
    <color name="wedora_text_on_primary">#1A1013</color>
    <color name="wedora_gradient_start">#FF93A8</color>
    <color name="wedora_gradient_end">#FE4667</color>
    <color name="wedora_success">#3FB56E</color>
    <!-- #FF6B6B, unchanged from the original spec — passes comfortably
         (5.70:1) once composited against wedora_error_bg's translucent
         fill; unlike light mode, no adjustment was needed here. -->
    <color name="wedora_error">#FF6B6B</color>
    <!-- 12% wedora_error over this file's wedora_bg, expressed as a direct
         translucent color per the original spec (rgba(255,107,107,0.12))
         rather than a pre-composited flat one, the same way Android
         renders any translucent fill against whatever is actually behind
         it. -->
    <color name="wedora_error_bg">#1FFF6B6B</color>
    <!-- Translucent tint of #E8536B (the ORIGINAL, unadjusted primary spec
         value) at 12%, per the exact rgba given for this token — tagText
         itself reuses wedora_accent's dark-mode value (#F0748A), which
         passes at 5.87:1 once composited against this. -->
    <color name="wedora_tag_bg">#1FE8536B</color>
    <color name="wedora_tag_text">#F0748A</color>
    <!-- Same fixed 60%-black scrim as light mode — see that file's comment. -->
    <color name="wedora_badge_overlay">#99000000</color>
    <color name="wedora_accent_shadow">#4DF0748A</color>
    <color name="wedora_accent_tint_12">#1FF0748A</color>
    <!-- Same value as light mode — see that file's comment. -->
    <color name="wedora_read_receipt">#4FC3F7</color>
    <color name="wedora_premium_gold">#E5A93B</color>
    <!-- Was left at the light-mode value (#FFDADE) — a bug, not a deliberate
         "fixed both modes" choice like wedora_warning_bg: wedora_text on an
         unchanged light pink measured ~1.12:1 in dark mode, effectively
         invisible. This muted deep maroon-pink keeps the same card
         identity while giving wedora_text ~14.15:1 and wedora_accent (the
         inline "Sign Up" span) ~4.70:1 — both clear WCAG AA passes — and
         stays clearly distinct from wedora_bg (#1C1417, luminance ~0.008)
         at roughly 1.8x its luminance (~0.0148), not just a fainter shade
         of the same near-black. -->
    <color name="wedora_guest_cta_bg">#2E1B22</color>

    <!-- WedoraPrimaryButton's disabled state. The light-mode pair (#FBBCC4
         bg + 60%-alpha white text) is a washed-out pastel that reads as
         "off" against a light page — reused unchanged in dark mode before
         this, it read as an oddly bright pink patch instead, and its own
         internal text contrast (already low by design — WCAG exempts
         disabled-control text from contrast requirements, this is
         intentionally muted, not a bug on light) got worse once the
         background got objectively brighter than the dark page around it
         rather than blending into a light one.
         Muted dark rose #7A3F47 instead: against wedora_bg (#1C1417,
         luminance ~0.008) it measures ~2.26:1 and against the enabled
         wedora_accent (previously #FA4659, now #F0748A post-rebrand — the
         ~2.32:1 figure is against the old value and wasn't re-measured
         against the new one; disabled-state colors were left out of the
         rebrand's scope) ~2.32:1 — clearly a distinct, deliberately
         desaturated version of the same rose family, not blending into
         either. Paired with full-opacity white text rather than carrying
         the 60%-alpha version over: at 60% alpha it measured ~4.01:1,
         just under AA's 4.5:1; at full opacity it's ~7.99:1. -->
    <color name="wedora_btn_disabled_bg">#7A3F47</color>
    <color name="wedora_btn_disabled_text">#FFFFFFFF</color>

    <!-- Surfaces — REBRAND, matching the light-mode inversion: page is now
         #1A1013 (was #1C1417, barely different) and cards are #241419
         (was #2A2124, also slightly darker than before) — same "card reads
         very slightly duller than the page" relationship as light mode. -->
    <color name="wedora_bg">#1A1013</color>
    <color name="wedora_surface">#241419</color>
    <color name="wedora_border">#3A2A2E</color>
    <!-- Same tone as wedora_border — see light values.xml's own comment for
         why the light value is a shade darker than its wedora_border; in
         dark mode wedora_border's existing value already gives enough
         definition against a photo, so no separate adjustment was needed. -->
    <color name="wedora_avatar_ring">#3A2A2E</color>

    <!-- Text -->
    <color name="wedora_text">#F5EEF0</color>
    <color name="wedora_text_secondary">#9B8A8E</color>

    <!-- Skeleton loading placeholders -->
    <color name="wedora_skeleton">#2E2529</color>

    <!-- Inputs — REBRAND: neutralBorder role, moving away from a
         wedora_border-matching value toward a distinct, slightly lighter
         neutral gray so input fields read as their own element rather than
         blending into every other bordered surface. -->
    <color name="wedora_input_bg">#241419</color>
    <color name="wedora_input_border">#4A373C</color>

    <!-- Decorative concentric rings behind the onboarding avatar collage -->
    <color name="wedora_ring_mid">#241A1D</color>
    <color name="wedora_ring_inner">#2E2226</color>

    <!-- Match screen radar background gradient — fixed brand colours, same both modes -->
    <color name="wedora_match_gradient_start">#FFE9EB</color>
    <color name="wedora_match_gradient_mid">#FE798A</color>

    <!-- Base -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- ===================================================================
         REDESIGN (v2) TOKENS — the real values, from Figma node 118:417
         ("wedoranew"). See values/colors.xml for why these are additive and
         why light mode aliases the old tokens instead of getting values of
         its own.

         Two values deviate from the Figma file, both to clear WCAG AA:

         1. wedora_v2_on_accent is #120D12 (dark), NOT white. White on
            #F43F5E measures 3.67:1 against a 4.5:1 requirement — the same
            failure #E8536B hit in the earlier rebrand. Darkening the fill to
            #EB0D33 would also clear it (4.53:1) but would change the
            designer's accent; dark text on the unchanged accent measures
            5.24:1 and preserves it. This mirrors what the base
            wedora_text_on_primary token already does in dark mode.

         2. wedora_v2_text_muted is #737B8A, lightened from the specified
            #6B7280. As given it measures 3.98:1 on #120D12, and it is used
            for 14sp-bold section headings and 10sp-bold nav labels — both
            below WCAG's large-text threshold, so 4.5:1 genuinely applies.
            #737B8A is the nearest lightening of the same hue that clears it,
            at 4.51:1.

         Everything else is verbatim from the design and measured passing:
         white on page 19.23:1, #9CA3AF on page 7.57:1, #F43F5E on page
         5.24:1, #FB7185 on the rose-15% pill 5.57:1.

         Text overlaid on profile photos (card name, age/location, distance)
         cannot be certified — contrast depends on the photo. The design's
         gradient scrims are the mitigation.
         =================================================================== -->
    <color name="wedora_v2_bg">#120D12</color>
    <color name="wedora_v2_surface">#1E161E</color>
    <color name="wedora_v2_accent">#F43F5E</color>
    <color name="wedora_v2_accent_soft">#FB7185</color>
    <color name="wedora_v2_on_accent">#120D12</color>
    <color name="wedora_v2_text">#FFFFFF</color>
    <color name="wedora_v2_text_secondary">#9CA3AF</color>
    <color name="wedora_v2_text_muted">#737B8A</color>
    <color name="wedora_v2_caption">#D1D5DB</color>
    <color name="wedora_v2_online">#22C55E</color>
    <!-- white 10% / white 5% — the design's hairline borders and glass fills -->
    <color name="wedora_v2_hairline">#1AFFFFFF</color>
    <color name="wedora_v2_glass">#0DFFFFFF</color>
    <color name="wedora_v2_glass_strong">#1AFFFFFF</color>
    <!-- black 30%, behind the circular icon buttons that sit over photos -->
    <color name="wedora_v2_scrim_dark">#4D000000</color>
    <!-- rose 15% fill / rose 30% border — the status pills on the card -->
    <color name="wedora_v2_pill_bg">#26F43F5E</color>
    <color name="wedora_v2_pill_border">#4DF43F5E</color>
    <color name="wedora_v2_pill_text">#FB7185</color>
</resources>
