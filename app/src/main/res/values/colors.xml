<?xml version="1.0" encoding="utf-8"?>
<!--
    Wedora design tokens — LIGHT mode.
    The dark-mode counterparts live in values-night/colors.xml and MUST use
    the same names so the system can swap them automatically.
-->
<resources>
    <!-- Brand — REBRAND (see values-night/colors.xml's own comment): unlike
         before, wedora_accent is no longer identical across modes — dark
         mode needs a brighter value so it doesn't look muddy against a
         near-black page, which in turn means its button-text pairing has to
         flip to a dark color in dark mode (see wedora_text_on_primary
         below) since white-on-bright-pink fails WCAG AA at that lightness.
         wedora_accent's own value is #E22A48, not the originally-requested
         #E8536B — #E8536B measured 3.57:1 with white button text (needs
         4.5:1); #E22A48 is the nearest darkening of the same hue that
         clears it, at 4.51:1. -->
    <color name="wedora_accent">#E22A48</color>
    <!-- Pressed/active state for anything using wedora_accent as a solid
         fill (see bg_button_primary_stateful.xml's new state_pressed item).
         Unchanged from the original spec — already 4.85:1 with white text,
         no adjustment needed. -->
    <color name="wedora_accent_pressed">#C93F55</color>
    <!-- Text/icon color for anything sitting ON a solid wedora_accent (or
         wedora_accent_pressed) fill — light mode simply reuses white, but
         this exists as its own token because dark mode's pairing is NOT
         white (see values-night's comment): keeping one token that both
         button-text selectors and any other on-accent content reference
         means dark mode's flip is a single override, not a hunt through
         every consumer. -->
    <color name="wedora_text_on_primary">#FFFFFF</color>
    <color name="wedora_gradient_start">#FF93A8</color>
    <color name="wedora_gradient_end">#FE4667</color>
    <color name="wedora_success">#3FB56E</color>
    <!-- #D4201B, not the originally-requested #E53935 — that measured
         3.65:1 against wedora_error_bg (needs 4.5:1); this is the nearest
         darkening of the same hue that clears it, at 4.51:1. -->
    <color name="wedora_error">#D4201B</color>
    <!-- Banner/toast surface behind wedora_error text — new token, the
         "errorBackground" role. -->
    <color name="wedora_error_bg">#FDEAEA</color>
    <!-- The "status • looking for" pill background/text (bg_intent_badge.xml)
         — new tokens, the "tagBackground"/"tagText" role. wedora_tag_text is
         #C6384F, not the originally-requested #C93F55 — that measured
         4.26:1 against wedora_tag_bg (needs 4.5:1); this is the nearest
         darkening of the same hue that clears it, at 4.52:1. -->
    <color name="wedora_tag_bg">#FDECEF</color>
    <color name="wedora_tag_text">#C6384F</color>
    <!-- Fixed 60%-black scrim for a badge sitting on a photo (the distance
         pill — bg_distance_pill.xml) rather than a themed surface, since a
         badge over a photo needs to read the same regardless of app theme —
         the photo underneath is the only thing that varies. Paired with
         white text, same both modes. -->
    <color name="wedora_badge_overlay">#99000000</color>
    <!-- 30% accent, used for the primary button's coloured drop shadow -->
    <color name="wedora_accent_shadow">#4DE22A48</color>
    <!-- ~12% accent, the outlined "Continue as Guest" button's tint fill —
         a wash of the border colour rather than a solid surface, so it reads
         as a secondary action next to Login's solid accent fill. -->
    <color name="wedora_accent_tint_12">#1FE22A48</color>
    <!-- WhatsApp-style read-receipt blue for the double checkmark once the
         recipient's lastReadAt has caught up to a sent message. Fixed in
         both modes, like the other brand colours here — it's a recognisable
         status colour, not a themed surface. -->
    <color name="wedora_read_receipt">#4FC3F7</color>
    <!-- Fixed brand gold, same both modes — marks "already Premium" states
         (Home's crown icon once isPremium == true) as distinct from the
         wedora_accent pink used for the upgrade-focused crown. -->
    <color name="wedora_premium_gold">#E5A93B</color>
    <!-- Soft pink — the guest profile's "create an account" banner.
         Deliberately flatter than bg_premium_card's gradient upsell: this is
         an encouraging preview, not a hard sell. Has its own dark-mode value
         in values-night/colors.xml (this light value was previously left
         unset there too, which broke text contrast — see that file's
         comment for the measured ratios). -->
    <color name="wedora_guest_cta_bg">#FFDADE</color>

    <!-- WedoraPrimaryButton's disabled state (bg_button_primary_stateful.xml
         / btn_primary_text_color.xml) — extracted to tokens so dark mode can
         override them instead of the drawable/selector carrying a hardcoded
         hex that can't respond to the night qualifier. Every button using
         that shared style (Login, Sign Up, all six profile-setup Continue
         buttons, Save, Apply Filters, Send Reset Link, Subscribe Now, ...)
         picks up either mode's value automatically. See values-night's own
         comment for the measured contrast this pair was chosen for. -->
    <color name="wedora_btn_disabled_bg">#FBBCC4</color>
    <color name="wedora_btn_disabled_text">#99FFFFFF</color>

    <!-- Surfaces — REBRAND: background/surfaceCard deliberately invert the
         previous hierarchy. Before, the page was a warm off-white
         (#FAF7F7) and cards were pure white — cards read brighter than the
         page. Now the page is pure white and cards are a very light gray
         (#F9F9F9) — cards read very slightly duller than the page instead.
         This is a real, visible change on every screen with a card, not a
         token rename. -->
    <color name="wedora_bg">#FFFFFF</color>
    <color name="wedora_surface">#F9F9F9</color>
    <!-- The "divider" role — general borders/separator lines. -->
    <color name="wedora_border">#EFEFEF</color>
    <!-- Avatar ring/stroke, everywhere a small circular photo has a border —
         was wedora_accent (or wedora_accent_shadow) throughout the app;
         replaced with a neutral tone so the ring reads as UI chrome rather
         than a status/action signal. Deliberately a shade darker than
         wedora_border rather than reusing it outright, for definition
         against photos of varied brightness. Left as-is in this rebrand —
         wedora_border's own shift (#F0EAEB -> #EFEFEF) is small enough that
         this relationship still holds without needing its own adjustment. -->
    <color name="wedora_avatar_ring">#E8E0E1</color>

    <!-- Text -->
    <color name="wedora_text">#1A1A1A</color>
    <color name="wedora_text_secondary">#6B6B6B</color>

    <!-- "This message was deleted" placeholder (bubble + Chats list preview).
         Exact values as given, fixed regardless of theme — deliberately not
         a values-night override like most colors here; both light and dark
         mode use this same #667781/#FFFFFF pair on purpose. -->
    <color name="wedora_message_deleted">#667781</color>
    <color name="wedora_message_deleted_bubble">#FFFFFF</color>

    <!-- Skeleton loading placeholders -->
    <color name="wedora_skeleton">#EFE7E9</color>

    <!-- Inputs — REBRAND: previously a pink-tinted wash (#FDEFF1 fill /
         #FBD3DA border); now the "inputFill"/"neutralBorder" roles, plain
         white with a neutral gray border, moving input chrome away from
         brand-tinted toward neutral. -->
    <color name="wedora_input_bg">#FFFFFF</color>
    <color name="wedora_input_border">#E0E0E0</color>

    <!-- Decorative concentric rings behind the onboarding avatar collage -->
    <color name="wedora_ring_mid">#FDF2F4</color>
    <color name="wedora_ring_inner">#FBE7EA</color>

    <!-- Match screen radar background gradient — fixed brand colours, same both modes -->
    <color name="wedora_match_gradient_start">#FFE9EB</color>
    <color name="wedora_match_gradient_mid">#FE798A</color>

    <!-- Presence: "online" green. Reads on both the light and the dark bar. -->
    <color name="wedora_online">#22C55E</color>

    <!-- Online-status dot overlaid on avatars app-wide. A distinct green from
         wedora_online (the chat header's presence text) — this is the exact
         value specified for the avatar-corner indicator. -->
    <color name="wedora_status_dot">#3FB56E</color>

    <!--
        Highlighted warning box (spam-folder tip). Deliberately a fixed light
        amber with dark amber text in both themes: it's meant to stand out as a
        callout, and dark text on the light box stays legible either way.
    -->
    <color name="wedora_warning_bg">#FFF8E1</color>
    <color name="wedora_warning_text">#8A6410</color>

    <!--
        "Update downloaded" snackbar surface — see UpdateReadySnackbar.

        Fixed near-black in BOTH themes, another deliberate "same both modes"
        choice. It carries white text and a coral disc, and a snackbar is an
        elevated overlay rather than part of the page, so it should read as the
        same dark chip either way. This existed as @color/wedora_text at first,
        which inverted to near-white in dark mode and left white-on-white text.
    -->
    <color name="wedora_snackbar_bg">#241A1D</color>

    <!-- Base -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
