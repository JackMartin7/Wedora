<?xml version="1.0" encoding="utf-8"?>
<!--
    Wedora design tokens — LIGHT mode.
    The dark-mode counterparts live in values-night/colors.xml and MUST use
    the same names so the system can swap them automatically.
-->
<resources>
    <!-- Brand — identical in light and dark -->
    <color name="wedora_accent">#FA4659</color>
    <color name="wedora_gradient_start">#FF93A8</color>
    <color name="wedora_gradient_end">#FE4667</color>
    <color name="wedora_success">#3FB56E</color>
    <color name="wedora_error">#E23B4E</color>
    <!-- 30% accent, used for the primary button's coloured drop shadow -->
    <color name="wedora_accent_shadow">#4DFA4659</color>
    <!-- Fixed brand gold, same both modes — marks "already Premium" states
         (Home's crown icon once isPremium == true) as distinct from the
         wedora_accent pink used for the upgrade-focused crown. -->
    <color name="wedora_premium_gold">#E5A93B</color>
    <!-- Soft pink — the guest profile's "create an account" banner.
         Deliberately flatter than bg_premium_card's gradient upsell: this is
         an encouraging preview, not a hard sell. Has its own dark-mode value
         in values-night/colors.xml (this light value was previously left
         unset there too, which broke text contrast — see that file's
         comment for the measured ratios). -->
    <color name="wedora_guest_cta_bg">#FFDADE</color>

    <!-- WedoraPrimaryButton's disabled state (bg_button_primary_stateful.xml
         / btn_primary_text_color.xml) — extracted to tokens so dark mode can
         override them instead of the drawable/selector carrying a hardcoded
         hex that can't respond to the night qualifier. Every button using
         that shared style (Login, Sign Up, all six profile-setup Continue
         buttons, Save, Apply Filters, Send Reset Link, Subscribe Now, ...)
         picks up either mode's value automatically. See values-night's own
         comment for the measured contrast this pair was chosen for. -->
    <color name="wedora_btn_disabled_bg">#FBBCC4</color>
    <color name="wedora_btn_disabled_text">#99FFFFFF</color>

    <!-- Surfaces -->
    <color name="wedora_bg">#FAF7F7</color>
    <color name="wedora_surface">#FFFFFF</color>
    <color name="wedora_border">#F0EAEB</color>

    <!-- Text -->
    <color name="wedora_text">#241A1D</color>
    <color name="wedora_text_secondary">#8C8589</color>

    <!-- Skeleton loading placeholders -->
    <color name="wedora_skeleton">#EFE7E9</color>

    <!-- Inputs -->
    <color name="wedora_input_bg">#FDEFF1</color>
    <color name="wedora_input_border">#FBD3DA</color>

    <!-- Decorative concentric rings behind the onboarding avatar collage -->
    <color name="wedora_ring_mid">#FDF2F4</color>
    <color name="wedora_ring_inner">#FBE7EA</color>

    <!-- Match screen radar background gradient — fixed brand colours, same both modes -->
    <color name="wedora_match_gradient_start">#FFE9EB</color>
    <color name="wedora_match_gradient_mid">#FE798A</color>

    <!-- Presence: "online" green. Reads on both the light and the dark bar. -->
    <color name="wedora_online">#22C55E</color>

    <!-- Online-status dot overlaid on avatars app-wide. A distinct green from
         wedora_online (the chat header's presence text) — this is the exact
         value specified for the avatar-corner indicator. -->
    <color name="wedora_status_dot">#3FB56E</color>

    <!--
        Highlighted warning box (spam-folder tip). Deliberately a fixed light
        amber with dark amber text in both themes: it's meant to stand out as a
        callout, and dark text on the light box stays legible either way.
    -->
    <color name="wedora_warning_bg">#FFF8E1</color>
    <color name="wedora_warning_text">#8A6410</color>

    <!-- Base -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
