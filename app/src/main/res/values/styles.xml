<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        DayNight base theme. Colours resolve from values/ or values-night/
        automatically, so there is no separate dark theme to maintain.
        Poppins is set as the default font family here, so every TextView,
        EditText and Button in the app picks it up without per-view attributes.
    -->
    <style name="Theme.Wedora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wedora_accent</item>
        <item name="colorAccent">@color/wedora_accent</item>
        <item name="colorError">@color/wedora_error</item>
        <item name="android:windowBackground">@color/wedora_bg</item>
        <item name="android:textColorPrimary">@color/wedora_text</item>
        <item name="android:textColorSecondary">@color/wedora_text_secondary</item>
        <item name="android:textColorHint">@color/wedora_text_secondary</item>

        <!-- Default typeface for the whole app -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>

        <!-- Every activity transition, set once here rather than at each
             startActivity call site — see WedoraWindowAnimation. -->
        <item name="android:windowAnimationStyle">@style/WedoraWindowAnimation</item>
    </style>

    <!--
        Push/pop transitions for every activity in the app.
        openEnter/openExit play when a screen is started, closeEnter/closeExit
        when one finishes, so forward and back read as opposites without any
        per-screen code.

        Screens that navigate "back" by starting their parent and finishing
        themselves are the exception: Android sees those as an open and would
        play the forward animation. They call applyBackTransition() to override
        it — see Transitions.kt.
    -->
    <style name="WedoraWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!--
        Splash keeps the brand gradient behind both system bars, so it
        always uses light (non-dark) icons — see
        SplashActivity.isLightSystemBars, which overrides the base's
        light/dark-following default with a fixed false instead of reading
        @bool/wedora_light_status_bar here.
    -->
    <style name="Theme.Wedora.Splash" parent="Theme.Wedora">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
    </style>

    <!--
        Theme for the image cropper's own Activity (see AndroidManifest, which
        overrides android:theme on com.canhub.cropper.CropImageActivity).

        It needs an ActionBar and Theme.Wedora doesn't have one. That library
        Activity's layout is nothing but a CropImageView, and it never calls
        setSupportActionBar — its Crop/rotate/flip actions live in the options
        menu and rely entirely on a theme-provided ActionBar. Inheriting the
        app theme, which is NoActionBar, meant the menu inflated into nothing
        and there was no way to confirm a crop at all.

        Deliberately NOT parented off Theme.Wedora: that would re-inherit
        NoActionBar and reintroduce exactly the bug this exists to fix.

        DarkActionBar, so the bar's content is light-on-dark — white on the
        accent fill, legible in both light and night mode. A DayNight inherit
        would flip the bar's text colour with the system theme while the fill
        stayed accent-coloured, which is how "invisible button" becomes
        "unreadable button".
    -->
    <style name="Theme.Wedora.Crop" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/wedora_accent</item>
        <item name="colorPrimaryVariant">@color/wedora_accent</item>
        <item name="colorAccent">@color/wedora_accent</item>
        <item name="android:statusBarColor">@color/wedora_accent</item>
    </style>

    <!-- Reusable input field style -->
    <style name="WedoraInputField">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/wedora_text</item>
        <item name="android:textColorHint">@color/wedora_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <!-- Field label ("Email", "Password", etc.) -->
    <style name="WedoraFieldLabel">
        <item name="android:textColor">@color/wedora_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- Primary CTA button (Login / Sign Up) -->
    <style name="WedoraPrimaryButton">
        <item name="android:background">@drawable/bg_button_primary_stateful</item>
        <item name="android:textColor">@color/btn_primary_text_color</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- Clears the background's 14dp corner radius, so a leading icon
             (see ConfirmBottomSheet.setLeadingIcon) sits outside the curve
             rather than inside it. Was previously unset, falling back to the
             theme buttonStyle's smaller default. -->
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <!-- Coloured drop shadow ~ 0 10px 20px rgba(250,70,89,0.3) -->
        <item name="android:elevation">10dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/wedora_accent_shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/wedora_accent_shadow</item>
    </style>

    <!-- Circular mask for ShapeableImageView (onboarding slide 3 profile photos) -->
    <style name="WedoraCircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded photo inside a match card -->
    <style name="WedoraCardImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Interest-tag chip label (onboarding slide 2) -->
    <style name="WedoraChipLabel">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/wedora_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!--
        Every switch in the app. The tints are ColorStateLists keyed on
        state_checked (res/color/, with dark-mode variants in res/color-night/),
        so on and off are visibly different states rather than two shades of
        the same one.

        Applied via style rather than repeated attributes so a switch added
        later picks this up by referencing one name, and a palette change
        happens in one place.
    -->
    <style name="WedoraSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <!--
        Pill chip for the marriage-intent selectors and the feed filters.
        Built on the Choice chip so ChipGroup handles selection and wrapping;
        the tints are ColorStateLists keyed on state_checked, so a chip added
        at runtime is styled without any per-chip code.
    -->
    <!--
        Modal bottom sheets. The theme swaps the sheet background for our
        rounded-top drawable and keeps the default dim and bottom-to-top slide
        that BottomSheetDialogFragment already provides.
    -->
    <style name="WedoraBottomSheetTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/WedoraBottomSheetModal</item>
    </style>

    <style name="WedoraBottomSheetModal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!--
        Dialog theme for the update download/failure cards.

        Transparent window background with no frame, because those layouts
        already draw their own rounded surface (bg_update_dialog) — leaving the
        platform background in would put a second, square card behind it. The
        dim is kept lighter than a full scrim so the app still reads as present
        behind a download that the user is invited to leave running.
    -->
    <style name="WedoraUpdateDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Secondary (Cancel) action inside a sheet: transparent, accent text. -->
    <style name="WedoraSecondaryButton">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/wedora_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- 20dp clears the widest radius this style is used with: the
             daily-limit sheet's tertiary button overrides the background to
             bg_pill_outline, whose 20dp corners are what made a leading icon
             collide with the curve. Matches WedoraPrimaryButton so the two
             stacked buttons on a sheet share one optical left edge. -->
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="WedoraChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_tint</item>
        <item name="android:textColor">@color/chip_text_tint</item>
        <item name="chipStrokeColor">@color/chip_stroke_tint</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="rippleColor">@color/wedora_input_border</item>
    </style>

    <!--
        Interest/hobby picker chip (sign-up, Edit Profile, Filters). Separate
        from WedoraChip rather than a variant of it: this one carries a
        leading icon and has no stroke — a filled solid-accent selected state
        and a light accent-tinted (not neutral-surface) unselected state, per
        the reference design, distinct from WedoraChip's outlined look used
        for Status/Looking For/report-reason chips elsewhere.
    -->
    <style name="WedoraInterestChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/interest_chip_bg_tint</item>
        <item name="android:textColor">@color/interest_chip_text_tint</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconTint">@color/interest_chip_icon_tint</item>
        <item name="chipIconSize">18dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="rippleColor">@color/wedora_input_border</item>
    </style>

</resources>
