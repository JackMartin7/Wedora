rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // On an update, request.resource.data is the POST-write document — the
    // incoming change merged over the existing fields. So this holds even for
    // an update that doesn't touch age itself, as long as the stored age is
    // already valid.
    function hasValidAge() {
      return 'age' in request.resource.data
          && request.resource.data.age is int
          && request.resource.data.age >= 18;
    }

    function ageAbsentOrValid() {
      return !('age' in request.resource.data) || hasValidAge();
    }

    // Any authenticated user can read the users collection (needed for the
    // matching query, which reads other users' gender/interestedIn), but a
    // user may only write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;

      // Sign-up creates this document before an age has been collected — age
      // is gathered later, by the Complete Profile step on first verified
      // login — so create tolerates a missing age, but never an invalid one.
      // (A doc created here without an age can only ever gain one via an
      // update, which is subject to the 18+ check below.)
      allow create: if isOwner(userId) && ageAbsentOrValid();

      // Every update must leave the document carrying an 18+ age. Combined
      // with the create rule above, an under-18 age can never be stored.
      allow update: if isOwner(userId) && hasValidAge();

      allow delete: if isOwner(userId);
    }

    // A match between two users. Document ID is the two UIDs sorted and
    // joined ("{uidA}_{uidB}"), so a given pair always maps to exactly one
    // document regardless of who liked first.
    match /matches/{matchId} {

      // Membership is read off the stored document, so this only applies to
      // operations on a document that already exists.
      function isMember() {
        return request.auth != null
            && request.auth.uid in resource.data.users;
      }

      // For a create there is no stored document yet, so validate the
      // incoming payload instead: exactly two distinct users, one of whom is
      // the caller. This stops a user fabricating matches between other
      // people, or matching themselves. likedBy must be the caller, so a like
      // can't be attributed to someone who didn't make it.
      function isValidNewMatch() {
        return request.auth != null
            && request.resource.data.users is list
            && request.resource.data.users.size() == 2
            && request.resource.data.users[0] != request.resource.data.users[1]
            && request.auth.uid in request.resource.data.users
            && request.resource.data.likedBy == request.auth.uid;
      }

      // The participant who did NOT send the like — the one it notifies.
      function isRecipient() {
        return request.auth != null
            && request.auth.uid in resource.data.users
            && resource.data.likedBy != request.auth.uid;
      }

      function onlyChangesSeenFlag() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['seenByRecipient']);
      }

      allow read: if isMember();
      allow create: if isValidNewMatch();

      // Updates stay open to members because liking is idempotent: tapping
      // like again re-runs set(merge), which rewrites createdAt. A rule
      // restricting updates to seenByRecipient alone would reject that and
      // break re-liking.
      //
      // Two things are still enforced. Participants can never change, so a
      // member can't rewrite a match onto someone else. And an update that
      // touches *only* seenByRecipient must come from the recipient — that is
      // the notification-clearing write, and the sender of a like has no
      // business marking it read on the other person's behalf.
      allow update: if isMember()
          && request.resource.data.users == resource.data.users
          && (!onlyChangesSeenFlag() || isRecipient());

      // Only the user who created the like can delete it (an unlike). The
      // recipient can dismiss it from their view via seenByRecipient, but
      // can't erase a like made for them.
      allow delete: if request.auth != null
          && resource.data.likedBy == request.auth.uid;

      match /messages/{messageId} {

        // Messages inherit access from the parent match document. This costs
        // one extra document read per rule evaluation, which is the standard
        // trade-off for subcollection ownership checks.
        function isMatchMember() {
          return request.auth != null
              && request.auth.uid in
                 get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        }

        allow read: if isMatchMember();

        // A sender can only post as themselves.
        allow create: if isMatchMember()
            && request.resource.data.senderId == request.auth.uid;

        // Messages are immutable — no edit or delete. Loosen deliberately if
        // the product ever wants "unsend".
        allow update, delete: if false;
      }
    }
  }
}
