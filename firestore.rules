// ============================================================================
//  ⚠️  DEPLOY AFTER EVERY CHANGE  ⚠️
//
//      firebase deploy --only firestore:rules
//
//  Editing this file does NOTHING until it's deployed. The live ruleset is
//  what Firestore enforces — an undeployed change leaves new collections
//  denied by default, which surfaces in-app as PERMISSION_DENIED (matches,
//  the likedBy/seenByRecipient fields, and reports/blocks each hit this).
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // On an update, request.resource.data is the POST-write document — the
    // incoming change merged over the existing fields. So this holds even for
    // an update that doesn't touch age itself, as long as the stored age is
    // already valid.
    function hasValidAge() {
      return 'age' in request.resource.data
          && request.resource.data.age is int
          && request.resource.data.age >= 18;
    }

    function ageAbsentOrValid() {
      return !('age' in request.resource.data) || hasValidAge();
    }

    // Any authenticated user can read the users collection (needed for the
    // matching query, which reads other users' gender/interestedIn), but a
    // user may only write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;

      // isPremium is admin-only. There is no in-app purchase flow — it's
      // granted by hand via Firebase Console, which (like the Admin SDK)
      // isn't subject to these rules at all, so this only ever constrains the
      // APP's own writes. Without it, a user could set isPremium: true on
      // their own document directly (bypassing the UI entirely — a modified
      // client, or a raw REST call) and get unlimited likes and every other
      // premium gate for free.
      function isPremiumUnchanged() {
        return request.resource.data.get('isPremium', false)
            == resource.data.get('isPremium', false);
      }

      // Best-effort only — see LikeLimit.kt's doc comment for the client-side
      // enforcement this backs up. This blocks the simplest abuse (spamming
      // likesGivenToday past 10 while likesGivenDate stays the same day), but
      // can't be made fully robust here: Firestore rules have no function to
      // format request.time into a "yyyy-MM-dd" string, so there's no way to
      // check a claimed likesGivenDate against the actual calendar date. A
      // modified client could still write an early/future date to force a
      // reset ahead of schedule. Known gap; would need a Cloud Function (none
      // exist in this project yet) to close properly.
      function likesLimitRespected() {
        return resource.data.get('isPremium', false)
            || request.resource.data.get('likesGivenDate', '')
                != resource.data.get('likesGivenDate', '')
            || request.resource.data.get('likesGivenToday', 0) <= 10;
      }

      // Same best-effort shape and the same gap as likesLimitRespected() above
      // — an independent quota, tracked in its own pair of fields, so it's
      // checked separately rather than folded into the same function.
      function messagesLimitRespected() {
        return resource.data.get('isPremium', false)
            || request.resource.data.get('messagesSentDate', '')
                != resource.data.get('messagesSentDate', '')
            || request.resource.data.get('messagesSentToday', 0) <= 10;
      }

      // The document is built up across the profile-setup steps, so both
      // create and update tolerate a missing age — step 1 creates it with a
      // name, steps 2 and 3 add gender and intent, and age only arrives at
      // step 4.
      //
      // The guarantee that matters is unchanged: an under-18 age can never be
      // STORED, because any write that carries an age must have it as an int
      // of 18 or more. What's no longer required is that every document has
      // one at all times, which was never a safety property — it was a side
      // effect of collecting age in a single screen.
      //
      // Requiring it on update would reject steps 2 and 3 outright: their
      // merged document has no age yet, so hasValidAge() is false and the
      // write is denied.
      allow create: if isOwner(userId) && ageAbsentOrValid();
      allow update: if isOwner(userId)
          && ageAbsentOrValid()
          && isPremiumUnchanged()
          && likesLimitRespected()
          && messagesLimitRespected();

      allow delete: if isOwner(userId);
    }

    // A match between two users. Document ID is the two UIDs sorted and
    // joined ("{uidA}_{uidB}"), so a given pair always maps to exactly one
    // document regardless of who liked first.
    match /matches/{matchId} {

      // Membership is read off the stored document, so this only applies to
      // operations on a document that already exists.
      function isMember() {
        return request.auth != null
            && request.auth.uid in resource.data.users;
      }

      // For a create there is no stored document yet, so validate the
      // incoming payload instead: exactly two distinct users, one of whom is
      // the caller. This stops a user fabricating matches between other
      // people, or matching themselves. likedUsers must be exactly the caller,
      // so a like can't be attributed to someone who didn't make it, and
      // nobody can create a match that arrives already mutual.
      function isValidNewMatch() {
        return request.auth != null
            && request.resource.data.users is list
            && request.resource.data.users.size() == 2
            && request.resource.data.users[0] != request.resource.data.users[1]
            && request.auth.uid in request.resource.data.users
            && request.resource.data.likedUsers == [request.auth.uid];
      }

      // Participants are compared as a SET, not as an ordered list.
      //
      // This is the bug that broke every like-back. The document ID is the two
      // UIDs sorted, so the second person to like updates the document the
      // first one created — but the client wrote `users` in caller order, so
      // the array arrived reversed. `==` on a list is order-sensitive, so the
      // check failed and the like-back was denied.
      //
      // The client now writes `users` sorted, which fixes it going forward.
      // Comparing as a set fixes it for the matches already stored in caller
      // order too, so no data migration is needed — and it still rejects any
      // update that actually changes who is in the match.
      function participantsUnchanged() {
        return request.resource.data.users.hasAll(resource.data.users)
            && resource.data.users.hasAll(request.resource.data.users)
            && request.resource.data.users.size() == 2;
      }

      // A caller may only add or remove THEMSELVES from a set field. Keeps
      // liking and marking-seen honest now that both are arrays: a member
      // can't like on the other person's behalf, un-like their like, or mark
      // their notification as read for them.
      function onlySelfIn(field) {
        return request.resource.data.get(field, []).hasAll(
                 resource.data.get(field, []).removeAll([request.auth.uid]))
            && resource.data.get(field, []).concat([request.auth.uid]).hasAll(
                 request.resource.data.get(field, []));
      }

      // Read receipts: lastReadAt is a map keyed by UID (`{uid}: timestamp`),
      // not a list, so it can't reuse onlySelfIn as-is. Same "self only"
      // intent though — a caller may only add or overwrite THEIR OWN key.
      // diff().affectedKeys() is the top-level keys that were added, removed
      // or changed between the stored map and the incoming one; requiring
      // that set to contain nothing but the caller's own UID blocks them
      // from ever writing (or clearing) the other participant's read time.
      function lastReadAtChangeIsSelfOnly() {
        return request.resource.data.get('lastReadAt', {})
            .diff(resource.data.get('lastReadAt', {}))
            .affectedKeys()
            .hasOnly([request.auth.uid]);
      }

      // hiddenBy is NOT symmetric like onlySelfIn, on purpose. A caller may
      // only ever ADD their own UID — "delete for me" — never force the chat
      // hidden for the other participant. But either UID may be REMOVED:
      // themselves (an unhide), or the other participant, which is exactly
      // what sending a new message does automatically so a chat the recipient
      // deleted reappears once there's something new in it. Removing only
      // ever makes a conversation MORE visible again, so unlike additions
      // there's nothing there worth restricting to "self only".
      function hiddenByAdditionsAreSelfOnly() {
        return request.resource.data.get('hiddenBy', [])
            .removeAll(resource.data.get('hiddenBy', []))
            .hasOnly([request.auth.uid]);
      }

      allow read: if isMember();
      allow create: if isValidNewMatch();

      // Updates stay open to members because liking is idempotent: tapping
      // like again re-runs set(merge), which rewrites createdAt. Liking back
      // is the same write, which is why it lands here rather than on create.
      //
      // Four things are enforced. Participants can never change, so a member
      // can't rewrite a match onto someone else. likedUsers / seenBy may only
      // ever gain or lose the caller — nobody likes, un-likes or dismisses a
      // notification on the other person's behalf. And hiddenBy may only gain
      // the caller (see hiddenByAdditionsAreSelfOnly) — nobody can hide the
      // chat from the other participant's list.
      //
      // This also covers the lastMessage summary (text/sentAt/senderId/
      // unreadCount) that the chat thread maintains: sending a message writes
      // it (and, in the same write, removes the recipient from hiddenBy), and
      // opening a thread zeroes unreadCount. All of these are member updates
      // that leave users/likedUsers/seenBy alone and only ever add themselves
      // to hiddenBy, so they pass here without a separate rule.
      //
      // lastReadAt (read receipts) is checked the same self-only way as
      // likedUsers/seenBy, just via lastReadAtChangeIsSelfOnly() since it's a
      // map rather than a list — see that function's own comment.
      allow update: if isMember()
          && participantsUnchanged()
          && onlySelfIn('likedUsers')
          && onlySelfIn('seenBy')
          && hiddenByAdditionsAreSelfOnly()
          && lastReadAtChangeIsSelfOnly();

      // Only someone who actually liked can delete the match (an unlike). The
      // recipient can dismiss it from their view via seenBy, but can't erase a
      // like made for them.
      //
      // Legacy fallback for documents predating likedUsers, which recorded the
      // single liker in likedBy. Drop the second clause once no such documents
      // remain.
      allow delete: if request.auth != null
          && (request.auth.uid in resource.data.get('likedUsers', [])
              || resource.data.get('likedBy', '') == request.auth.uid);

      match /messages/{messageId} {

        // Messages inherit access from the parent match document. This costs
        // one extra document read per rule evaluation, which is the standard
        // trade-off for subcollection ownership checks.
        function isMatchMember() {
          return request.auth != null
              && request.auth.uid in
                 get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        }

        // The recipient's "only matched users can message me" setting.
        //
        // Enforced here rather than only in the UI: a privacy control that the
        // client can decline to apply isn't one. A modified client, or simply
        // an older build that predates the setting, would otherwise sail past
        // it.
        //
        // "Matched" means mutual — both participants in likedUsers. A one-sided
        // like creates the match document (this app matches instantly), so
        // without this check anyone who likes you can open a thread and write
        // to you, which is exactly what the setting exists to prevent.
        //
        // Default is false: absent means the user never turned it on, and a
        // privacy control must never be applied to someone who didn't ask for
        // it — silently muting an existing conversation would be worse than
        // not having the feature.
        function recipientAcceptsMessageFrom(matchData) {
          let others = matchData.users.removeAll([request.auth.uid]);
          let recipientGate = others.size() == 1
              && get(/databases/$(database)/documents/users/$(others[0]))
                   .data.get('onlyMatchesCanMessage', false) == true;
          return !recipientGate
              || matchData.get('likedUsers', []).hasAll(matchData.users);
        }

        allow read: if isMatchMember();

        // A sender can only post as themselves, and only if the recipient
        // accepts messages from them.
        allow create: if isMatchMember()
            && request.resource.data.senderId == request.auth.uid
            && recipientAcceptsMessageFrom(
                 get(/databases/$(database)/documents/matches/$(matchId)).data);

        // Messages are immutable — no edit or delete. Loosen deliberately if
        // the product ever wants "unsend".
        allow update, delete: if false;
      }
    }

    // Reports are write-only from the client: a signed-in user can file one
    // (as themselves), but no client can read, edit or delete them. An admin
    // reviews them out of band.
    match /reports/{reportId} {
      allow create: if request.auth != null
          && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Each user owns their own block list and nobody else can see it.
    match /blocks/{userId}/blockedUsers/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Same shape as blocks: who this user has swiped past, readable and
    // writable only by them. Kept private not because a pass is sensitive in
    // itself, but because the set of people someone declined says a lot about
    // them and nothing another user needs.
    match /passes/{userId}/passedUsers/{passedUid} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // One view record per unique viewer. The viewer can only ever write their
    // own entry — recordProfileView always writes as the signed-in user, never
    // on anyone else's behalf — and only the profile owner can read the list
    // of who viewed them. A viewer can't read this back to confirm their own
    // view landed; nothing in the app needs that, and opening read access to
    // the viewer too would let anyone enumerate who's been looking at a given
    // profile.
    match /profileViews/{viewedUid}/viewers/{viewerUid} {
      allow read: if request.auth != null && request.auth.uid == viewedUid;
      allow write: if request.auth != null && request.auth.uid == viewerUid;
    }
  }
}
