rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read the users collection (needed for the
    // matching query, which reads other users' gender/interestedIn), but a
    // user may only create/update/delete their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
