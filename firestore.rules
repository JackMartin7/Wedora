// ============================================================================
//  ⚠️  DEPLOY AFTER EVERY CHANGE  ⚠️
//
//      firebase deploy --only firestore:rules
//
//  Editing this file does NOTHING until it's deployed. The live ruleset is
//  what Firestore enforces — an undeployed change leaves new collections
//  denied by default, which surfaces in-app as PERMISSION_DENIED (matches,
//  the likedBy/seenByRecipient fields, and reports/blocks each hit this).
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The one Firebase Auth UID with admin access to the Reports queue —
    // see AdminReportsActivity/AdminReportDetailActivity, and
    // WedoraAdmin.UID on the client, which this must be kept in sync with
    // by hand (Firestore rules can't reference a Kotlin constant). Also
    // duplicated in functions/src/index.ts's disableUserAccount for the
    // same reason — three places, one value, no single source of truth
    // possible across languages/deploy targets.
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'QgOuA5no4jR6hsFoNp5UFWMceHk2';
    }

    // On an update, request.resource.data is the POST-write document — the
    // incoming change merged over the existing fields. So this holds even for
    // an update that doesn't touch age itself, as long as the stored age is
    // already valid.
    function hasValidAge() {
      return 'age' in request.resource.data
          && request.resource.data.age is int
          && request.resource.data.age >= 18;
    }

    function ageAbsentOrValid() {
      return !('age' in request.resource.data) || hasValidAge();
    }

    // Strict two-gender policy: gender and interestedIn may only ever be
    // "male" or "female" — enforced here, not just in the sign-up UI, since
    // a modified client or a raw write could otherwise still store a third
    // value. Same "absent OR valid" shape as ageAbsentOrValid() above and
    // for the same reason: both fields are built up across profile-setup
    // steps (gender/interestedIn arrive together at step 2, before age at
    // step 4), so an update mid-setup that doesn't touch either field yet
    // must still be allowed through.
    function isValidGenderValue(value) {
      return value in ['male', 'female'];
    }

    function genderAbsentOrValid() {
      return !('gender' in request.resource.data)
          || isValidGenderValue(request.resource.data.gender);
    }

    function interestedInAbsentOrValid() {
      return !('interestedIn' in request.resource.data)
          || isValidGenderValue(request.resource.data.interestedIn);
    }

    // Auto-selected opposite-gender matching: interestedIn is never picked
    // independently client-side (see Gender.opposite and the three places
    // gender is ever set — ProfileStep2GenderActivity, EditProfileActivity,
    // GuestGenderPromptActivity), and this is that guarantee re-enforced
    // server-side, since a modified client or a raw write could otherwise
    // still pair them mismatched.
    function isOppositeGender(g) {
      return g == 'male' ? 'female' : 'male';
    }

    // Only meaningful once BOTH fields exist in the resulting document —
    // gender and interestedIn arrive together at profile-setup step 2, so a
    // write carrying just one (or neither), like step 1's displayName-only
    // create, is still fine and this simply doesn't apply yet.
    function genderInterestedInPairedIfBothPresent() {
      return !('gender' in request.resource.data)
          || !('interestedIn' in request.resource.data)
          || request.resource.data.interestedIn
               == isOppositeGender(request.resource.data.gender);
    }

    // On update, the pairing is only checked when THIS write actually
    // touches gender or interestedIn — not on every future write forever,
    // which would otherwise permanently lock out any account whose already-
    // stored pair predates this rule (nothing retroactively fixes existing
    // data; see the go-forward-only decision this was scoped to). A write
    // touching neither field — a bio edit, a photo, anything else on this
    // document — is exempt regardless of what's already stored.
    function genderChangeKeepsPairing() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['gender', 'interestedIn'])
          || genderInterestedInPairedIfBothPresent();
    }

    // Any authenticated user can read the users collection (needed for the
    // matching query, which reads other users' gender/interestedIn), but a
    // user may only write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;

      // isPremium is otherwise admin-only (granted by hand via Firebase
      // Console, which — like the Admin SDK — isn't subject to these rules
      // at all). The one exception the app itself is allowed to make is
      // BillingManager recording a real Play Billing purchase: the write
      // must carry a non-empty purchaseToken and one of the two known
      // subscription product IDs. This is best-effort, not real
      // verification — there is no backend here to check that token against
      // Google's Play Developer API, so a modified client could still forge
      // a token/productId pair and grant itself Premium for free. Same
      // documented-gap shape as likesLimitRespected()/messagesLimitRespected()
      // below, just for a bigger prize; closing it properly needs a Cloud
      // Function (none exist in this project yet) that verifies the token
      // server-side before ever trusting it.
      function isPremiumUnchanged() {
        return request.resource.data.get('isPremium', false)
            == resource.data.get('isPremium', false);
      }

      function isPremiumChangeFromPurchase() {
        return request.resource.data.get('purchaseToken', '') is string
            && request.resource.data.get('purchaseToken', '') != ''
            && request.resource.data.get('productId', '')
                 in ['wedora_premium_monthly', 'wedora_premium_yearly'];
      }

      // Best-effort only — see LikeLimit.kt's doc comment for the client-side
      // enforcement this backs up. This blocks the simplest abuse (spamming
      // likesGivenToday past 10 while likesGivenDate stays the same day), but
      // can't be made fully robust here: Firestore rules have no function to
      // format request.time into a "yyyy-MM-dd" string, so there's no way to
      // check a claimed likesGivenDate against the actual calendar date. A
      // modified client could still write an early/future date to force a
      // reset ahead of schedule. Known gap; would need a Cloud Function (none
      // exist in this project yet) to close properly.
      // bonusLikesToday is the rewarded-ad allowance (see RewardedAds /
      // LikeLimit.kt) and widens the ceiling by exactly what was earned.
      // It's itself capped at 10, which is what keeps the existing gap from
      // getting worse: the rules can't verify an ad was watched any more
      // than they can verify the date below, so a modified client could
      // still forge a bonus — but the cap bounds that at double the free
      // allowance rather than unlimited.
      function likesLimitRespected() {
        return resource.data.get('isPremium', false)
            || request.resource.data.get('likesGivenDate', '')
                != resource.data.get('likesGivenDate', '')
            || (request.resource.data.get('bonusLikesToday', 0) <= 10
                && request.resource.data.get('likesGivenToday', 0)
                     <= 10 + request.resource.data.get('bonusLikesToday', 0));
      }

      // The rewarded-ad rate limit: one earned bonus per 10 minutes.
      //
      // Unlike the daily caps above, this one IS enforceable. Their gap is
      // that rules can't format request.time into "yyyy-MM-dd" to check a
      // claimed date; a cooldown needs no formatting, only timestamp
      // arithmetic. request.time is set by the server, so moving the device
      // clock does nothing here — a client that skips its local countdown
      // gets an ad view that pays out nothing.
      //
      // Only constrains writes that touch a bonus field, so it never blocks
      // an ordinary profile edit. lastRewardedAdAt must equal request.time
      // on such a write, which is what forces it to be a real server
      // timestamp rather than a client-chosen one — otherwise a client could
      // backdate it and clear its own cooldown.
      //
      // One field for both quotas: the cooldown is global, rate-limiting ad
      // views rather than either quota individually.

      // Any change to the bonus quartet, not just a numeric increase: a
      // grant on a new calendar day writes 10 -> 1, which is a decrease, and
      // a ">" test would wave exactly that write through uncontrolled. Only
      // RewardedAds.grantBonus ever touches these four fields, so gating all
      // changes to them costs an ordinary profile edit nothing.
      function bonusFieldsChanged() {
        return request.resource.data.get('bonusLikesToday', 0)
                 != resource.data.get('bonusLikesToday', 0)
            || request.resource.data.get('bonusMessagesToday', 0)
                 != resource.data.get('bonusMessagesToday', 0)
            || request.resource.data.get('bonusLikesDate', '')
                 != resource.data.get('bonusLikesDate', '')
            || request.resource.data.get('bonusMessagesDate', '')
                 != resource.data.get('bonusMessagesDate', '');
      }
      // ---- COMPATIBILITY WINDOW — remove writtenByCurrentClient() below
      //      once the cooldown build has rolled out. ----
      //
      // The version live on Play when this shipped does not write
      // lastRewardedAdAt at all. Enforcing the strict rule immediately would
      // reject every one of those users' bonus writes: they would watch a
      // full rewarded ad and silently receive nothing, which is the worst
      // failure this flow has. So a write that leaves the field exactly as
      // it found it is grandfathered through.
      //
      // Two shapes count as "left alone": the field is absent from the
      // incoming document at all (a user who has never run the new build),
      // or it's present only because a merge write carried the stored value
      // forward unchanged (a user who ran the new build on one device and
      // an old build on another). Tested with `in` rather than comparing
      // against null so the result doesn't rest on null-equality semantics.
      //
      // What this costs: for the length of the window the cooldown is
      // enforced only for clients that opt in by writing the field — the
      // current build always does, so real users are limited, but a modified
      // client can bypass it by simply omitting the field. That is exactly
      // today's situation (no server cooldown at all), so the window is a
      // delay in gaining enforcement, not a new hole.
      function writtenByCurrentClient() {
        return ('lastRewardedAdAt' in request.resource.data)
            && !(('lastRewardedAdAt' in resource.data)
                 && request.resource.data.lastRewardedAdAt
                      == resource.data.lastRewardedAdAt);
      }
      function rewardedCooldownRespected() {
        return !bonusFieldsChanged()
            || !writtenByCurrentClient()
            || (request.resource.data.lastRewardedAdAt == request.time
                && (!('lastRewardedAdAt' in resource.data)
                    || request.time > resource.data.lastRewardedAdAt
                                        + duration.value(10, 'm')));
      }

      // Same best-effort shape and the same gap as likesLimitRespected() above
      // — an independent quota, tracked in its own pair of fields, so it's
      // checked separately rather than folded into the same function.
      // The base allowance is 5, not 10: messages are the scarcer resource of
      // the two, so the message cap is deliberately tighter than the like cap
      // rather than tracking it. Mirrors FREE_DAILY_MESSAGE_LIMIT in
      // MessageLimit.kt, which is the client-side half of the same number.
      //
      // The bonus cap is 5 here against likes' 10 — each quota's cap equals
      // its own base, which is what keeps "at most double" true for both.
      // A shared 10 against this lower base would quietly make the ad path
      // worth twice the free allowance on messages alone.
      function messagesLimitRespected() {
        return resource.data.get('isPremium', false)
            || request.resource.data.get('messagesSentDate', '')
                != resource.data.get('messagesSentDate', '')
            || (request.resource.data.get('bonusMessagesToday', 0) <= 5
                && request.resource.data.get('messagesSentToday', 0)
                     <= 5 + request.resource.data.get('bonusMessagesToday', 0));
      }

      // The document is built up across the profile-setup steps, so both
      // create and update tolerate a missing age — step 1 creates it with a
      // name, steps 2 and 3 add gender and intent, and age only arrives at
      // step 4.
      //
      // The guarantee that matters is unchanged: an under-18 age can never be
      // STORED, because any write that carries an age must have it as an int
      // of 18 or more. What's no longer required is that every document has
      // one at all times, which was never a safety property — it was a side
      // effect of collecting age in a single screen.
      //
      // Requiring it on update would reject steps 2 and 3 outright: their
      // merged document has no age yet, so hasValidAge() is false and the
      // write is denied.

      // likesReceivedCount is maintained ONLY by the onMatchWritten Cloud
      // Function (see functions/src/index.ts), which runs under the Admin
      // SDK and is not subject to these rules. No client ever has a reason
      // to write it, and the owner-only rule above would otherwise let
      // someone set their own like count to anything they liked — the
      // cheapest possible vanity forgery, and one that would be invisible
      // since the value is displayed verbatim on their card.
      //
      // Unchanged-or-absent rather than simply absent: an ordinary profile
      // edit sends the whole merged document, so the field is present on
      // most writes and requiring its absence would reject them all.
      function likesReceivedCountUnchanged() {
        return request.resource.data.get('likesReceivedCount', 0)
            == resource.data.get('likesReceivedCount', 0);
      }

      allow create: if isOwner(userId)
          && ageAbsentOrValid()
          && genderAbsentOrValid()
          && interestedInAbsentOrValid()
          && genderInterestedInPairedIfBothPresent();
      allow update: if isOwner(userId)
          && ageAbsentOrValid()
          && genderAbsentOrValid()
          && interestedInAbsentOrValid()
          && genderChangeKeepsPairing()
          && (isPremiumUnchanged() || isPremiumChangeFromPurchase())
          && likesLimitRespected()
          && messagesLimitRespected()
          && rewardedCooldownRespected()
          && likesReceivedCountUnchanged();

      // Admin-only exception, evaluated as an OR alongside the owner-only
      // allow update above (Firestore grants a write if ANY matching allow
      // statement is true) — the admin UID may set isBanned/banReason on
      // ANY user's document after reviewing a report, and nothing else.
      // Scoped tightly via diff().affectedKeys() so admin status can't
      // become a backdoor to edit anything else on someone's profile.
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isBanned', 'banReason']);

      allow delete: if isOwner(userId);
    }

    // A match between two users. Document ID is the two UIDs sorted and
    // joined ("{uidA}_{uidB}"), so a given pair always maps to exactly one
    // document regardless of who liked first.
    match /matches/{matchId} {

      // Membership is read off the stored document, so this only applies to
      // operations on a document that already exists.
      //
      // The `resource != null` guard matters beyond the obvious missing-
      // document case: matchExistsQuery (LikeLimit.kt) deliberately queries
      // by document ID rather than get()-ing it, specifically so a match
      // that doesn't exist yet returns an empty result instead of being
      // denied outright — resource.data.users can't be evaluated on a null
      // resource. Without this guard, that field access throws during rule
      // evaluation rather than cleanly returning false, and an unhandled
      // throw makes Firestore reject the whole query with PERMISSION_DENIED
      // instead of just excluding the (nonexistent) candidate document and
      // returning empty — exactly the failure this function is supposed to
      // avoid. The same applies to a match doc deleted via unlike while a
      // messages subcollection under it still lingers (Firestore doesn't
      // cascade-delete subcollections), which hits this same null-resource
      // path on a genuinely still-relevant matchId.
      function isMember() {
        return request.auth != null
            && resource != null
            && request.auth.uid in resource.data.users;
      }

      // For a create there is no stored document yet, so validate the
      // incoming payload instead: exactly two distinct users, one of whom is
      // the caller. This stops a user fabricating matches between other
      // people, or matching themselves. likedUsers must be exactly the caller,
      // so a like can't be attributed to someone who didn't make it, and
      // nobody can create a match that arrives already mutual.
      function isValidNewMatch() {
        return request.auth != null
            && request.resource.data.users is list
            && request.resource.data.users.size() == 2
            && request.resource.data.users[0] != request.resource.data.users[1]
            && request.auth.uid in request.resource.data.users
            && request.resource.data.likedUsers == [request.auth.uid];
      }

      // Participants are compared as a SET, not as an ordered list.
      //
      // This is the bug that broke every like-back. The document ID is the two
      // UIDs sorted, so the second person to like updates the document the
      // first one created — but the client wrote `users` in caller order, so
      // the array arrived reversed. `==` on a list is order-sensitive, so the
      // check failed and the like-back was denied.
      //
      // The client now writes `users` sorted, which fixes it going forward.
      // Comparing as a set fixes it for the matches already stored in caller
      // order too, so no data migration is needed — and it still rejects any
      // update that actually changes who is in the match.
      function participantsUnchanged() {
        return request.resource.data.users.hasAll(resource.data.users)
            && resource.data.users.hasAll(request.resource.data.users)
            && request.resource.data.users.size() == 2;
      }

      // A caller may only add or remove THEMSELVES from a set field. Keeps
      // liking and marking-seen honest now that both are arrays: a member
      // can't like on the other person's behalf, un-like their like, or mark
      // their notification as read for them.
      function onlySelfIn(field) {
        return request.resource.data.get(field, []).hasAll(
                 resource.data.get(field, []).removeAll([request.auth.uid]))
            && resource.data.get(field, []).concat([request.auth.uid]).hasAll(
                 request.resource.data.get(field, []));
      }

      // Read receipts: lastReadAt is a map keyed by UID (`{uid}: timestamp`),
      // not a list, so it can't reuse onlySelfIn as-is. Same "self only"
      // intent though — a caller may only add or overwrite THEIR OWN key.
      // diff().affectedKeys() is the top-level keys that were added, removed
      // or changed between the stored map and the incoming one; requiring
      // that set to contain nothing but the caller's own UID blocks them
      // from ever writing (or clearing) the other participant's read time.
      function lastReadAtChangeIsSelfOnly() {
        return request.resource.data.get('lastReadAt', {})
            .diff(resource.data.get('lastReadAt', {}))
            .affectedKeys()
            .hasOnly([request.auth.uid]);
      }

      // hiddenBy is NOT symmetric like onlySelfIn, on purpose. A caller may
      // only ever ADD their own UID — "delete for me" — never force the chat
      // hidden for the other participant. But either UID may be REMOVED:
      // themselves (an unhide), or the other participant, which is exactly
      // what sending a new message does automatically so a chat the recipient
      // deleted reappears once there's something new in it. Removing only
      // ever makes a conversation MORE visible again, so unlike additions
      // there's nothing there worth restricting to "self only".
      function hiddenByAdditionsAreSelfOnly() {
        return request.resource.data.get('hiddenBy', [])
            .removeAll(resource.data.get('hiddenBy', []))
            .hasOnly([request.auth.uid]);
      }

      allow read: if isMember();
      allow create: if isValidNewMatch();

      // Updates stay open to members because liking is idempotent: tapping
      // like again re-runs set(merge), which rewrites createdAt. Liking back
      // is the same write, which is why it lands here rather than on create.
      //
      // Four things are enforced. Participants can never change, so a member
      // can't rewrite a match onto someone else. likedUsers / seenBy may only
      // ever gain or lose the caller — nobody likes, un-likes or dismisses a
      // notification on the other person's behalf. And hiddenBy may only gain
      // the caller (see hiddenByAdditionsAreSelfOnly) — nobody can hide the
      // chat from the other participant's list.
      //
      // This also covers the lastMessage summary (text/sentAt/senderId/
      // unreadCount) that the chat thread maintains: sending a message writes
      // it (and, in the same write, removes the recipient from hiddenBy), and
      // opening a thread zeroes unreadCount. All of these are member updates
      // that leave users/likedUsers/seenBy alone and only ever add themselves
      // to hiddenBy, so they pass here without a separate rule.
      //
      // lastReadAt (read receipts) is checked the same self-only way as
      // likedUsers/seenBy, just via lastReadAtChangeIsSelfOnly() since it's a
      // map rather than a list — see that function's own comment.
      allow update: if isMember()
          && participantsUnchanged()
          && onlySelfIn('likedUsers')
          && onlySelfIn('seenBy')
          && hiddenByAdditionsAreSelfOnly()
          && lastReadAtChangeIsSelfOnly();

      // Only someone who actually liked can delete the match (an unlike). The
      // recipient can dismiss it from their view via seenBy, but can't erase a
      // like made for them.
      //
      // Legacy fallback for documents predating likedUsers, which recorded the
      // single liker in likedBy. Drop the second clause once no such documents
      // remain.
      allow delete: if request.auth != null
          && (request.auth.uid in resource.data.get('likedUsers', [])
              || resource.data.get('likedBy', '') == request.auth.uid);

      match /messages/{messageId} {

        // Messages inherit access from the parent match document. This costs
        // one extra document read per rule evaluation, which is the standard
        // trade-off for subcollection ownership checks.
        function isMatchMember() {
          return request.auth != null
              && request.auth.uid in
                 get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        }

        // Everyone who has liked, on this match.
        //
        // The UNION of likedUsers and the legacy scalar likedBy it replaced,
        // mirroring Match.kt's parseLikedUsers and the Cloud Function's
        // likersOf. Liking back on a legacy document writes
        // likedUsers = [the second liker] while the original liker survives
        // only in likedBy, so reading the array alone reports a genuinely
        // mutual pair as one-sided.
        //
        // That inconsistency was harmless while mutuality only drove an opt-in
        // toggle. It is load-bearing now: a wrong verdict here locks a
        // conversation. About eleven documents still carry the legacy field.
        function likersOf(matchData) {
          return matchData.get('likedBy', null) == null
              ? matchData.get('likedUsers', [])
              : matchData.get('likedUsers', []).concat([matchData.get('likedBy', '')]);
        }

        // Whether messaging is open on this match.
        //
        // MUTUAL LIKE IS NOW MANDATORY, for everyone. It used to be an opt-in
        // privacy setting (onlyMatchesCanMessage, which only ten of 537 users
        // had ever enabled) layered over a model where any one-sided like
        // opened a thread by default. A one-sided like still creates the match
        // document - that is what surfaces the like at all - but it no longer
        // grants the ability to write.
        //
        // GRANDFATHERING: a match that already has messages stays open even if
        // it is not mutual. lastMessage is written on the match document in the
        // same batch as every message (see MessageLimit.kt), so its presence
        // means "this conversation has been used" - no separate flag, no
        // backfill, and no extra read, since this rule already holds matchData.
        // Measured against production when this shipped: 621 one-sided
        // conversations had messages and stay open; 1,964 one-sided matches had
        // none and become gated.
        //
        // Enforced here rather than only in the UI: a client can decline to
        // apply a client-side gate, and older builds predate this rule.
        function messagingUnlocked(matchData) {
          return matchData.get('lastMessage', null) != null
              || likersOf(matchData).hasAll(matchData.users);
        }

        /**
         * A message must have real content and stay within a sane size.
         *
         * ChatThreadActivity.sendMessage already trims and checks
         * text.isEmpty() before ever calling Firestore — this is that same
         * check re-enforced server-side, since a modified client or a raw
         * write against the API bypasses anything client-only. Rules has no
         * trim(), so `(?s).*[^\s].*` (DOTALL, so a leading/trailing newline
         * doesn't hide the real content from the wildcards) stands in for
         * "non-empty once whitespace-only padding doesn't count".
         *
         * 2000 chars is generous for a chat message and comfortably below
         * Firestore's own per-document limits — it exists to stop someone
         * writing an arbitrarily large document, not to constrain normal use.
         * It's unrelated to the 200-char cap onMessageSent (functions/src/
         * index.ts) truncates the FCM push preview to — that's a payload-size
         * concern for the notification, not a rule about what may be stored.
         */
        function isValidMessageText() {
          return request.resource.data.text is string
              && request.resource.data.text.matches('(?s).*[^\\s].*')
              && request.resource.data.text.size() <= 2000;
        }

        /**
         * replyTo is optional (most messages aren't replies), so absence is
         * valid too — this only shapes it when present: a map with exactly
         * messageId/senderId/text, all non-empty strings, text bounded the
         * same as REPLY_PREVIEW_MAX_CHARS's own generous headroom on the
         * client (Message.kt).
         *
         * Deliberately NOT verified to reference a real message in this
         * match — that would need a second get() per message send (on top
         * of the one isMatchMember() already spends), doubling the read
         * cost of every message in the app, and still wouldn't stop a
         * modified client pairing a real messageId with a fabricated
         * senderId/text — this is a private 1:1 thread between two already-
         * matched users, and the value of that check doesn't justify either
         * cost. Same accepted-trust-boundary shape as the like/message daily
         * limits' date field and BillingManager's purchaseToken above.
         *
         * text's 200-char ceiling is headroom above the client's own
         * REPLY_PREVIEW_MAX_CHARS (120, Message.kt) — a bound to stop an
         * arbitrarily large quoted snippet, not meant to be exact.
         */
        function isValidReplyTo() {
          return !('replyTo' in request.resource.data)
              || (request.resource.data.replyTo.keys().hasOnly(['messageId', 'senderId', 'text'])
                  && request.resource.data.replyTo.messageId is string
                  && request.resource.data.replyTo.messageId.size() > 0
                  && request.resource.data.replyTo.senderId is string
                  && request.resource.data.replyTo.senderId.size() > 0
                  && request.resource.data.replyTo.text is string
                  && request.resource.data.replyTo.text.size() > 0
                  && request.resource.data.replyTo.text.size() <= 200);
        }

        // ---- Contact-sharing backstop -----------------------------------
        //
        // Server-side half of the check in ContactShareDetector.kt. The
        // client shows the warning and blocks the send; this stops a
        // modified client that skips that UI from writing the message
        // anyway. Every function below takes the already-lowercased text so
        // lower() is only paid once at the call site.
        //
        // RE2 notes: matches() is a FULL-string match, so every pattern is
        // wrapped in .* — and (?s) is required on all of them because the
        // composer accepts multi-line input and . excludes newlines by
        // default (same reason isValidMessageText() carries it).
        //
        // Two things the client catches that this deliberately cannot:
        // Arabic-Indic digits (٠-٩), which [0-9] doesn't match, and any
        // normalize-then-rerun handling of mixed obfuscation. Those are
        // accepted gaps in the backstop, not in the product check.

        function hasEmail(t) {
          return t.matches('(?s).*[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}.*');
        }

        // Closed TLD list, matching the client's: an open \.[a-z]{2,} would
        // fire on "M.Sc", "U.S.A" and any missing space after a full stop.
        function hasUrl(t) {
          return t.matches('(?s).*(https?://|www\\.).*')
              || t.matches('(?s).*\\.(com|net|org|io|me|co|ly|gg|app|link|xyz|info|site|online|shop|store)\\b.*');
        }

        // Unambiguous brands only — signal/line/imo/snap/zoom are ordinary
        // English and are excluded here for the same reason as on the
        // client. \b matters: bare "insta" would fire on "instant".
        function hasAppName(t) {
          return t.matches('(?s).*\\b(whatsapp|whats ?app|wa\\.me|instagram|insta|telegram|t\\.me|snapchat|viber|wechat|tiktok|skype|messenger)\\b.*');
        }

        // Strips only space/dot/paren/hyphen before counting, never comma or
        // slash — stripping those would merge "1,500,000" and "12/25/2024"
        // into long runs. 9, not 7 or 8: 7 blocks plain PKR amounts, and 8
        // blocks any all-numeric date once hyphens are stripped, which on a
        // marriage app means birthdays and wedding dates. Keep in step with
        // MIN_DIGIT_RUN in ContactShareDetector.kt.
        function hasPhoneDigits(t) {
          return t.replace('[ .()\\-]', '').matches('(?s).*[0-9]{9,}.*');
        }

        function hasSpelledDigits(t) {
          return t.matches('(?s).*\\b((zero|one|two|three|four|five|six|seven|eight|nine|oh)[^a-z0-9]{0,3}){5,}(zero|one|two|three|four|five|six|seven|eight|nine|oh)\\b.*');
        }

        function hasNoContactInfo(t) {
          return !hasEmail(t)
              && !hasUrl(t)
              && !hasAppName(t)
              && !hasPhoneDigits(t)
              && !hasSpelledDigits(t);
        }

        /** The full set of top-level keys this update actually touches. */
        function affectedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        /**
         * "Delete for everyone": the sender only, and only as an exact
         * 3-key transition — deleted/deletedAt/text change together or not
         * at all. Write-once (resource.data.deleted must currently be
         * false/absent) so a second attempt can't bump deletedAt forward or
         * otherwise re-trigger this path.
         *
         * affectedKeys().size() == 3 alongside hasOnly() matters more than it
         * looks: hasOnly() alone is a SUBSET check, not equality, so without
         * the size guard an update touching only `text` — leaving
         * deleted/deletedAt untouched — would still satisfy
         * hasOnly(['deleted','deletedAt','text']), silently reopening free
         * text edits for the sender. Caught writing this, verified with a
         * dedicated emulator test rather than trusted by inspection.
         *
         * deletedAt must equal request.time — the one comparison that proves
         * it came from FieldValue.serverTimestamp() rather than a
         * client-forged value, since Firestore substitutes request.time for
         * a pending server timestamp sentinel at rule-evaluation time.
         *
         * text must be entirely ABSENT from the write (FieldValue.delete()),
         * not merely emptied to '' — keeps "deleted" from leaving a ghost
         * empty string a client has to know to special-case.
         */
        function isDeleteForEveryone() {
          return request.auth.uid == resource.data.senderId
              && !resource.data.get('deleted', false)
              && affectedKeys().size() == 3
              && affectedKeys().hasOnly(['deleted', 'deletedAt', 'text'])
              && request.resource.data.deleted == true
              && request.resource.data.deletedAt == request.time
              && !('text' in request.resource.data);
        }

        /**
         * "Delete for me": append-only. A caller may add their own uid to
         * deletedFor and nothing else — not another participant's uid, and
         * not a removal of any uid already present (there is no "undo
         * delete for me" in this feature, so a removal is never legitimate
         * here, whoever it targets).
         */
        function isDeleteForMe() {
          return affectedKeys().hasOnly(['deletedFor'])
              && request.resource.data.deletedFor
                   .hasAll(resource.data.get('deletedFor', []))
              && request.resource.data.deletedFor
                   .removeAll(resource.data.get('deletedFor', []))
                   .hasOnly([request.auth.uid]);
        }

        /**
         * A reaction, when present, must be a short non-empty string — sized
         * generously enough for a multi-codepoint emoji (variation
         * selectors, ZWJ sequences) without allowing arbitrary payloads.
         * Absent (the caller's key isn't in the new map at all) is always
         * fine — that's a removal/untap, not a value to validate.
         */
        function isValidReactionValue() {
          return !(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() > 0
                  && request.resource.data.reactions[request.auth.uid].size() <= 8);
        }

        /**
         * Reactions: only the caller's own key in the map may change — same
         * self-only-map shape as the parent match doc's
         * lastReadAtChangeIsSelfOnly(), just scoped to this field. Covers
         * set, change, and remove (untap) uniformly, since all three show up
         * identically as "this uid's key changed" in the diff.
         */
        function isReactionUpdate() {
          return affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions
                   .diff(resource.data.get('reactions', {}))
                   .affectedKeys()
                   .hasOnly([request.auth.uid])
              && isValidReactionValue();
        }

        allow read: if isMatchMember();

        // A sender can only post as themselves, with real content, and only
        // if messaging is open on this match - mutual like, or a
        // conversation that already has messages. None of the fields
        // the three update paths below own may be set at creation time —
        // closes the gap where a raw write could otherwise create an
        // already-"deleted" message or forge another uid's reaction/hide
        // from day one.
        allow create: if isMatchMember()
            && request.resource.data.senderId == request.auth.uid
            && isValidMessageText()
            && isValidReplyTo()
            && hasNoContactInfo(request.resource.data.text.lower())
            && !('deleted' in request.resource.data)
            && !('deletedFor' in request.resource.data)
            && !('reactions' in request.resource.data)
            && messagingUnlocked(
                 get(/databases/$(database)/documents/matches/$(matchId)).data);

        // Three narrow, mutually exclusive update paths — everything else
        // about a message (senderId, sentAt, text outside a deletion) stays
        // immutable by construction: each function only allows its own exact
        // key set to change, so no combination of these three can ever touch
        // a field none of them owns.
        allow update: if isMatchMember()
            && (isDeleteForEveryone() || isDeleteForMe() || isReactionUpdate());

        // The document itself is still never hard-deleted.
        allow delete: if false;
      }
    }

    // Reports are write-only from any signed-in client: they can file one
    // (as themselves), but can never read the queue back or edit/delete an
    // existing report — that's the admin's job, done in-app now via
    // AdminReportsActivity/AdminReportDetailActivity rather than out of
    // band.
    match /reports/{reportId} {
      allow create: if request.auth != null
          && request.resource.data.reporterUid == request.auth.uid;

      allow read: if isAdmin();

      // The admin may only ever change status (to one of the four known
      // values)/resolvedAt/actionTaken — never reattribute a report's
      // reportedUid/reporterUid/reason, which would rewrite what actually
      // happened rather than record a decision about it.
      allow update: if isAdmin()
          && request.resource.data.status
               in ['pending', 'resolved', 'dismissed', 'banned']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'actionTaken']);

      allow delete: if false;
    }

    // Blocked contact-sharing attempts (see ContactShareDetector.kt and the
    // messages create rule's hasNoContactInfo above). Same write-only-to-
    // admin-read shape as reports, but a separate collection on purpose:
    // these are system-generated, about one specific message, append-only,
    // and carry no pending/resolved workflow — folding them into reports
    // would bury the real moderation queue under automated noise.
    //
    // Append-only by design: an offender can file their own attempt but can
    // never read the feed back, amend it, or delete the evidence. There is
    // no admin UI for this yet — it's Firebase-Console-visible only.
    match /contactShareAttempts/{attemptId} {
      allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid;

      allow read: if isAdmin();

      allow update, delete: if false;
    }

    // Each user owns their own block list and nobody else can see it.
    match /blocks/{userId}/blockedUsers/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Same shape as blocks: who this user has swiped past, readable and
    // writable only by them. Kept private not because a pass is sensitive in
    // itself, but because the set of people someone declined says a lot about
    // them and nothing another user needs.
    match /passes/{userId}/passedUsers/{passedUid} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // One view record per unique viewer. The viewer can only ever write their
    // own entry — recordProfileView always writes as the signed-in user, never
    // on anyone else's behalf.
    //
    // Read is normally owner-only: a viewer can't read this back to confirm
    // their own view landed day-to-day, and opening read access to the whole
    // list would let anyone enumerate who's been looking at a given profile.
    // The one exception is a viewer reading their OWN entry (viewerUid ==
    // caller) — added for AccountSettingsActivity's delete-account cleanup,
    // which needs to find every "I viewed someone" record a departing user
    // left under other users' owned subcollections via a
    // collectionGroup('viewers') query; Firestore denies a collection-group
    // query outright unless every potentially-matching document is
    // individually readable, so without this the query itself would fail
    // before it could find anything to delete. Still never exposes another
    // viewer's entry or the full per-profile list to anyone but the owner.
    match /profileViews/{viewedUid}/viewers/{viewerUid} {
      allow read: if request.auth != null
          && (request.auth.uid == viewedUid || request.auth.uid == viewerUid);

      // Recording a view stays viewer-only. Letting the profile owner create
      // or amend entries here would let anyone manufacture their own viewer
      // list, which is the whole thing this collection is trusted for.
      allow create, update: if request.auth != null && request.auth.uid == viewerUid;

      // Delete is deliberately wider than create/update: the OWNER of the
      // profile must be able to remove view records left on it.
      //
      // This split is what account deletion was missing. AccountSettingsActivity
      // reads profileViews/{uid}/viewers to clear the record of who viewed the
      // departing user — reads that the rule above already allows — and then
      // batches those refs for deletion. Under a single viewer-only `write`
      // rule every one of those deletes was rejected, and because a batch is
      // atomic the whole account deletion failed with PERMISSION_DENIED for
      // any user who had ever been viewed. An account with no viewers deleted
      // cleanly, which is why this survived testing.
      //
      // Widening delete rather than read is the narrow fix: it grants the
      // owner power only over data attached to their own profile, and still
      // never lets them see or forge another viewer's entry elsewhere.
      allow delete: if request.auth != null
          && (request.auth.uid == viewerUid || request.auth.uid == viewedUid);
    }

    // Collection-group read over every 'viewers' collection, which is a
    // DIFFERENT operation from anything the block above can authorise.
    //
    // AccountSettingsActivity's delete-account cleanup runs
    // collectionGroup('viewers').whereEqualTo('viewerUid', uid) to find the
    // views a departing user made on OTHER people's profiles — records that
    // live under those users' own profileViews/{otherUid}/viewers
    // subcollections, so they aren't reachable from this user's own document.
    //
    // A concrete-path rule cannot permit that query. A collection-group query
    // is an operation over every collection with that ID anywhere in the
    // database, and only a rule whose match path begins with the {path=**}
    // recursive wildcard applies to one. The profileViews/{viewedUid}/viewers
    // block above is scoped to that one nesting, so the query was denied
    // outright — before any document was examined — and took the whole
    // enumerate step down with it. That failed on every account, including
    // ones with no views at all; it is not the same bug as the delete-vs-write
    // split above, which is why fixing that one changed nothing here.
    //
    // Tests resource.data.viewerUid rather than a {viewerUid} path wildcard.
    // The two agree today, since recordProfileView writes the document with
    // the viewer's uid as its ID, but nothing enforces that invariant — and a
    // single document whose ID drifted from its field would be returned by the
    // query's filter, denied by a path check, and fail the whole query again.
    // Matching on exactly what the query filters on removes that class of
    // silent, data-dependent breakage.
    //
    // Read only. Writes and deletes reach these documents by concrete
    // reference and stay governed entirely by the block above; this grants no
    // access that the `request.auth.uid == viewerUid` branch there didn't
    // already allow.
    match /{path=**}/viewers/{docId} {
      allow read: if request.auth != null
          && resource.data.get('viewerUid', '') == request.auth.uid;
    }
  }
}
